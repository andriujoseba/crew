#!/usr/bin/env bash
# crew — spawn and tend a fleet of role-focused coding agents, on a host with
# `box` installed.
#
# The command surface is the CMDS table below: it is the single source of truth
# for what exists, what it looks like, what the help says, and what runs. This
# comment deliberately does NOT list the commands — it used to, it was printed
# verbatim as `crew help`, and it drifted: it advertised `crew hire <box>
# [--force]` long after the verb grew --role, --agent and --ref. `crew help`
# renders from the table now, so it cannot say something the code does not do.
#
# What a reader of this file needs that the help does not carry:
#
#   CREW_CONFIG_DIR selects one fleet definition directory. CREW_ROSTER is the
#   exceptional roster-only fixture override; it does not select a fleet
#   context. `fleet.roster` is the proof file: directories without one are
#   skipped, while an explicitly invalid CREW_CONFIG_DIR is an error. `crew
#   floor --roster` (CREW_FLOOR_ROSTER) does the same for the console. Use
#   these to drill against a subset — editing examples/fleet.roster to test is
#   how a leftover drill box came to count as a fleet member (#51).
#
#   The lifecycle is create → login → hire, and the middle step is a HUMAN one:
#   `crew auth` automated it and was REMOVED (danmt, 2026-07-25) until the rest
#   of the fleet is proven — vendor logins are flaky and change often, and
#   half-automating a step you still have to babysit buys nothing but a second
#   thing to debug. `crew help` carries the operator-facing version of this.
set -euo pipefail

# Resolve THIS script's real path before deriving the root. Installed, `crew`
# on PATH is a symlink ($BINDIR/crew -> …/current/cli/crew), so a plain
# $0/dirname would put CREW_ROOT in $BINDIR instead of the versioned tree.
# readlink -f follows the whole chain; on a plain checkout it is a no-op
# (the installer that creates that layout is install.sh, heavy-duty/crew#95).
CREW_ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck disable=SC1091
source "$CREW_ROOT/shared/lib/version-skew.sh"
ROLES_DIR="$CREW_ROOT/shared/conf/roles"
AGENTS_DIR="$CREW_ROOT/shared/conf/agents"

# A version is a DIRECTORY NAME under the installer's versions/ — nothing else.
# Byte-identical to install.sh's copy; shared/test/run.sh diffs the two so the
# gate the installer trusts and the gate the CLI trusts (crew use / uninstall,
# heavy-duty/crew#96) cannot drift.
valid_version() {
  case "$1" in
    ''|.*|-*) return 1 ;;
    *[!A-Za-z0-9._+-]*) return 1 ;;
  esac
  return 0
}
if [ "${CREW_CONFIG_DIR+x}" = x ]; then
  if [ -z "$CREW_CONFIG_DIR" ] || [ ! -d "$CREW_CONFIG_DIR" ] ||
     [ ! -f "$CREW_CONFIG_DIR/fleet.roster" ]; then
    echo "crew: CREW_CONFIG_DIR '$CREW_CONFIG_DIR' is not a fleet definition (fleet.roster is required)" >&2
    exit 1
  fi
  CONFIG_DIR="$(cd "$CREW_CONFIG_DIR" && pwd)"
  CONFIG_IS_OPERATOR=1
else
  CONFIG_DIR=""
  CONFIG_IS_OPERATOR=0
  if [ -n "${XDG_CONFIG_HOME:-}" ]; then CONFIG_CANDIDATE="$XDG_CONFIG_HOME/crew"
  else CONFIG_CANDIDATE="$HOME/.config/crew"; fi
  for candidate in "$CONFIG_CANDIDATE" "$PWD" "$CREW_ROOT/examples"; do
    if [ -d "$candidate" ] && [ -f "$candidate/fleet.roster" ]; then
      CONFIG_DIR="$(cd "$candidate" && pwd)"
      [ "$CONFIG_DIR" = "$CREW_ROOT/examples" ] || CONFIG_IS_OPERATOR=1
      break
    fi
  done
  [ -n "$CONFIG_DIR" ] || { echo "crew: no fleet definition found (fleet.roster is required)" >&2; exit 1; }
fi
# Completeness is checked on WHATEVER directory resolution selected, operator
# or fallback. It used to run only under CONFIG_IS_OPERATOR=1, which gave the
# least-trusted definition the least verification: an operator config missing
# a required file failed loudly, and a shipped-examples directory missing one
# ran unchecked (#216). Nothing about "is this file here" depends on who wrote
# the directory.
missing=""
for required in fleet.conf repos.txt; do
  [ -f "$CONFIG_DIR/$required" ] || missing="$missing $required"
done
[ -z "$missing" ] ||
  { echo "crew: fleet definition '$CONFIG_DIR' is incomplete; missing:$missing" >&2; exit 1; }
# Rehearsals that claim to exercise operator-owned configuration set this
# assertion. Keep it beside resolution so a missing CREW_CONFIG_DIR cannot
# silently fall through to examples/ and turn a real-host drill into coverage
# of the wrong mode (#82).
if [ "${CREW_EXPECT_OPERATOR_CONFIG:-0}" = 1 ] && [ "$CONFIG_IS_OPERATOR" -ne 1 ]; then
  echo "crew: operator-config mode required, but resolution selected '$CONFIG_DIR' (CONFIG_IS_OPERATOR=0)" >&2
  exit 1
fi
config_file() { [ -f "$CONFIG_DIR/$1" ] && printf '%s\n' "$CONFIG_DIR/$1" || printf '%s\n' "$CREW_ROOT/examples/$1"; }
# agent_conf NAME — the one resolved profile path every reader uses: an
# operator `agents/NAME.conf` beside the fleet definition wins over the
# same-named shipped profile; the shipped set is the fallback (#75). Adding a
# vendor is configuration, so it must not require editing the tracked tree —
# and a name clash resolves to the operator, or a fleet could never adjust a
# vendor it did not invent.
agent_conf() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ] && [ -f "$CONFIG_DIR/agents/$1.conf" ]; then
    printf '%s\n' "$CONFIG_DIR/agents/$1.conf"
  else
    printf '%s\n' "$AGENTS_DIR/$1.conf"
  fi
}
# agent_names — every profile name agent_conf can resolve, shipped and
# operator, unsorted and possibly repeated; callers `sort -u`.
agent_names() {
  local f
  for f in "$AGENTS_DIR"/*.conf; do
    if [ -f "$f" ]; then basename "$f" .conf; fi
  done
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then
    for f in "$CONFIG_DIR"/agents/*.conf; do
      if [ -f "$f" ]; then basename "$f" .conf; fi
    done
  fi
}
ROSTER="${CREW_ROSTER:-$CONFIG_DIR/fleet.roster}"
FLEET_CONF="$(config_file fleet.conf)"
REPOS_SEED="$(config_file repos.txt)"
NOTIFY_REPOS_SEED="$(config_file notify-repos.txt)"
DOCTRINE_CONF="$(config_file doctrine.conf)"
CREW_REPO="${CREW_REPO:-heavy-duty/crew}"
# Two tick boundaries — the fleet's death rule. MUST equal fleet-floor's
# SILENT_AFTER_S (floor.py: 2 * TICK_S); shared/test/run.sh fails if it does
# not. Kept here rather than in the in-box script so the number lives on the
# host, once per reader, and never inside a box that cannot see either.
SILENT_AFTER_S="${CREW_SILENT_AFTER:-600}"

# Two failures, two exit codes — because crew is called from scripts and from
# `crew up` loops, and "the fleet is broken" and "you typo'd" used to return
# the same 1. The line between them (#97):
#
#   2  the fault is in the INVOCATION — an unknown command, a missing,
#      unknown or conflicting flag, or an argument naming something the
#      CONFIGURATION does not define (an agent or role with no profile, a
#      box with no roster row). Nothing was attempted.
#   1  the fault is in the WORLD — the box CLI is absent, no roster file,
#      the box already exists, incus said no, a guard refused. You asked
#      correctly and the answer was no.
#
# The rule that decides the near-misses: the roster and the profiles are
# CONFIGURATION, so naming something absent from them is 2; boxes and the
# daemon are STATE, so their absence is 1. `crew hire nosuchbox` is 1 (the
# box is not there yet), `crew new --agent nosuchvendor` is 2 (no such
# profile is defined anywhere).
die() { echo "crew: $*" >&2; exit 1; }         # 1 = it went wrong
usage_error() { echo "crew: $*" >&2; echo "try 'crew help'." >&2; exit 2; }  # 2 = you asked wrong
need_box() { command -v box >/dev/null || die "the 'box' CLI is not on PATH — crew runs on a box host"; }

# The examples fallback is a definition NOBODY WROTE, and it must not be able
# to create infrastructure or arm cron (#216). Resolution ends at
# $CREW_ROOT/examples only when a host has no operator config at all, and
# before this that host presented as a fully configured seven-box fleet:
# `crew up` created seven boxes and armed cron against the three live
# repositories the shipped registry then named, with nothing in the output
# saying the definition was not the operator's. The shipped registry ships
# empty now, which closes the "aimed at somebody else's boards" half; this
# closes the other half — a scaffold is a thing to READ, never a mandate to
# act on.
#
# WHERE THESE ARE CALLED FROM is the load-bearing part, and it follows crew's
# own two-exit-code split above: a malformed invocation is diagnosed FIRST and
# still exits 2, because the operator asked wrong before the world could
# answer. The refusal is a WORLD fault — you asked correctly and the answer is
# no — so it exits 1, and every call site sits after that verb's argument
# parsing (and after resolve_engine, which is where a bad --ref earns its 2)
# and before that verb's first mutation.
require_operator_config() { # VERB
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then return 0; fi
  die "$1 refuses under the shipped example fleet definition at $CONFIG_DIR.
  Nobody configured this host, so there is nothing here to create or arm: the
  examples are a scaffold to read, not a fleet to run. Scaffold your own —
    crew init
  then edit the generated files (repos.txt ships EMPTY: name your repos) and
  run again. 'crew status', 'crew profiles' and 'crew up --dry-run' keep
  working here, which is how you inspect a host in this state."
}

# The read-only half of the same rule. `status`, `profiles` and `up --dry-run`
# are how someone INSPECTS an unconfigured host, so they keep working — but
# they say what they are reading, because the reported symptom was a table
# nobody could tell from a configured fleet's.
#
# On stderr deliberately: these verbs print tables, and a banner mixed into
# the rows is a second thing every reader of that stdout has to filter. A
# terminal shows both; a pipe keeps the rows it asked for.
fallback_banner() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then return 0; fi
  echo "crew: NOTE this host has NO operator fleet definition." >&2
  echo "crew: reading the shipped examples at $CONFIG_DIR — a scaffold, not an operator definition." >&2
  echo "crew: 'crew init' scaffolds one; until then no verb here will create a box or arm cron." >&2
}

# `--flag` with no value is a malformed invocation and must exit 2 like every
# other one. Reading "$2" directly under `set -u` makes BASH kill the process
# with its own "unbound variable" and exit 1 — so `crew new --agent` reported
# "the fleet is broken" for a typo, which is the exact confusion the split
# above exists to end. `${2:?...}` has the same defect: it is bash's error and
# bash's exit code, not ours (codex, review of #106).
#
# Called as `need_value "$@"` from inside the option's case branch, where "$1"
# is the flag and "$2" is its value if one was given. An EMPTY value is
# refused too, matching what the `${2:?}` sites already did.
need_value() { { [ "$#" -ge 2 ] && [ -n "$2" ]; } || usage_error "$1 needs a value"; }

# ...and the mirror of that: an argument BEYOND the synopsis was silently
# ignored. `crew help hire unexpected` printed hire's help and exited 0
# (codex, round 2 of #106), and `crew profiles junk` / `crew down junk` did
# the same. A verb whose parser is a while-loop already refuses these; the
# ones that read "${1:-}" positionally never looked. The table declares each
# synopsis, so the count comes from there rather than from a second opinion.
max_args() {  # $1 = verb, $2 = how many it accepts, then "$@" as given
  local verb="$1" max="$2"; shift 2
  [ "$#" -le "$max" ] || usage_error "too many arguments (usage: $(synopsis_of "$verb"))"
}


# The tree's own version, read in ONE place — `crew --version` says it out
# loud, and hire/upgrade stamp it onto a box (#94), so a box can name the
# release that put its engine there. crew_version is deliberately STRICT: a
# missing VERSION must fail the stamp loudly rather than write "unknown" onto
# a box. Only the display wrapper tolerates its absence.
crew_version() { head -1 "$CREW_ROOT/VERSION" | tr -d '\r\n'; }
version() { echo "crew $(crew_version 2>/dev/null || echo unknown) ($CREW_ROOT)"; }

# ---------------------------------------------------------------------------
# The command table.
#
#   verb ^ synopsis ^ one-line summary ^ function
#
# It is the single source of truth for what exists, what it looks like, what
# the help says, and what runs. The help cannot drift from the code because it
# is rendered from the rows that dispatch. Before this, the command list lived
# THREE times — the header comment printed as help, a hand-written dispatch
# `case`, and each verb's own usage string — and they had already diverged:
# the header advertised `crew hire <box> [--force]` while the verb had grown
# --role, --agent and --ref.
#
# Fields are ^-separated because a synopsis contains '|' and '[]' freely.
#
# crew's table is four fields, not box's seven: every crew verb is a shell
# function with its own argument parsing, so there is no precondition engine
# or thin-wrapper action to encode. Copying box's shape here would have been
# five empty columns.
CMDS=(
  "new^<roster-name> | --role <r> --agent <a> [--name <n>] [--from <box>[/<snap>]]^Create one box — infrastructure only; it does nothing until hired^cmd_new"
  "create-all^^Create every roster box that does not exist yet^cmd_create_all"
  "hire^<box> [--role <r> --agent <a>] [--ref <version-or-git-ref>] [--force] [--allow-offroster]^Put a box on duty: engine installed, cron armed. Idempotent^cmd_hire"
  "hire-all^[--ref <version-or-git-ref>]^Hire every created roster box; skips those already at this version^cmd_hire_all"
  "up^[--dry-run]^Converge the fleet: create missing, start stopped, hire, report^cmd_up"
  "down^^Stop every roster box^cmd_down"
  "status^[<box>]^Engine version and duty evidence, per box^cmd_status"
  "versions^^List installed host versions and mark the current and running trees^cmd_versions"
  "use^<version>^Switch the default host version; report box engines left behind^cmd_use"
  "uninstall^[<version>] [--all] [--force]^Remove one host version or the whole console, with fleet guards^cmd_uninstall"
  "upgrade^<box> | --all [--ref <version-or-git-ref>] [--force]^Ship the engine from this host and re-install it in place^cmd_upgrade"
  "gold^<box> [--force]^Snapshot a box as a gold image — cut PRE-login, credential-free^cmd_gold"
  "floor^[--port <n>] [--bind <a>] [--local] [--user <u>] [--pass <p>] [--roster <path>] [--interval <s>]^Serve the fleet-floor console on IP:PORT^cmd_floor"
  "init^[config-dir]^Scaffold a new operator fleet definition^cmd_init"
  "profiles^^List the role and agent profiles this crew resolves^cmd_profiles"
  "help^[<command>]^This help, or 'crew help <command>' for one command^cmd_help"
)

# Named verb_row, not cmd_row: the `cmd_` prefix marks a VERB IMPLEMENTATION
# and nothing else, so "every cmd_* has a table row" is checkable without an
# exclusion list. An exclusion list is the thing that rots.
verb_row() { local r; for r in "${CMDS[@]}"; do case "$r" in "$1^"*) echo "$r"; return 0 ;; esac; done; return 1; }
verbs()   { local r; for r in "${CMDS[@]}"; do echo "${r%%^*}"; done; }
is_command() { verb_row "$1" >/dev/null 2>&1; }
# locals matter: field() is called from inside dispatch, which holds its own
# row — a global read would clobber the row being dispatched.
field() {
  local r f_syn f_sum f_fn
  r="$(verb_row "$1")" || return 1
  IFS='^' read -r _ f_syn f_sum f_fn <<<"$r"
  case "$2" in syn) echo "$f_syn" ;; sum) echo "$f_sum" ;; fn) echo "$f_fn" ;; esac
}
synopsis_of() { local s; s="$(field "$1" syn)"; echo "crew $1${s:+ $s}"; }

# `adopt` was renamed to `hire`. It stays dispatchable so an old script does
# not break, and it stays OUT of the table so the help does not advertise a
# retired name. Normalizing here rather than in the dispatch `case` means
# `crew help adopt` lands on hire's help too, instead of "unknown command".
normalize_verb() {
  case "$1" in
    adopt) echo "crew: 'adopt' is now 'hire'" >&2; printf 'hire\n' ;;
    *) printf '%s\n' "$1" ;;
  esac
}

# Nearest verb by edit distance — a typo should point somewhere, not just fail.
suggest() {
  verbs | awk -v w="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" '
    function dist(a, b,   la, lb, i, j, c, prev, cur) {
      la = length(a); lb = length(b)
      for (j = 0; j <= lb; j++) prev[j] = j
      for (i = 1; i <= la; i++) {
        cur[0] = i
        for (j = 1; j <= lb; j++) {
          c = (substr(a, i, 1) == substr(b, j, 1)) ? 0 : 1
          cur[j] = prev[j] + 1
          if (cur[j - 1] + 1 < cur[j]) cur[j] = cur[j - 1] + 1
          if (prev[j - 1] + c < cur[j]) cur[j] = prev[j - 1] + c
        }
        for (j = 0; j <= lb; j++) prev[j] = cur[j]
      }
      return prev[lb]
    }
    BEGIN { best = 99 }
    { d = dist(w, $0); if (d < best) { best = d; hit = $0 } }
    END { if (best <= 2) print hit }'
}

unknown_command() {
  local hint; hint="$(suggest "$1")"
  if [ -n "$hint" ]; then
    echo "crew: unknown command: $1 — did you mean '$hint'?" >&2
  else
    echo "crew: unknown command: $1" >&2
  fi
  echo "try 'crew help' for the command list." >&2
  exit 2
}

usage() {
  cat <<'EOF'
crew — spawn and tend a fleet of role-focused coding agents, on a box host.

USAGE
  crew <command> [<args>] [options]

COMMANDS
EOF
  local r v sum
  for r in "${CMDS[@]}"; do
    IFS='^' read -r v _ sum _ <<<"$r"
    printf '  %-11s %s\n' "$v" "$sum"
  done
  cat <<'EOF'

THE LIFECYCLE — two verbs around one human step in the middle

  create  crew new / crew create-all — infrastructure only. The box is minted
          from its agent's box template (rig converges the vendor CLI) and
          sized by the role profile. It has no engine and no cron: it does
          nothing at all until it is hired.
  login   BY HAND, once per box, ever. 'crew auth' was removed until the
          fleet is proven — vendor logins are flaky and half-automating a
          step you still babysit buys a second thing to debug:
              box shell <box>      # then, inside the box:
              gh auth login        # a NEW identity — one box per identity
              <the agent profile's login hint — see 'crew profiles'>
          'crew status' and 'crew up' report who still owes this.
  hire    crew hire / crew hire-all — the box joins the crew: engine
          installed at this tree's version, cron armed, on duty at the next
          five-minute boundary. An idempotent upsert.

  A fleet from scratch: install box and crew, 'crew create-all', log each box
  in by hand, 'crew hire-all'. Steady state afterwards is just 'crew up'.

ENVIRONMENT
  CREW_CONFIG_DIR   Select one fleet definition directory. An invalid value
                    is an error, never a silent fall-through to the examples.
  CREW_ROSTER       Roster-only override, for drills and fixtures. It does
                    NOT select a fleet context.
  CREW_FLOOR_*      PORT, BIND, USER, PASS, INTERVAL, ROSTER — the console's
                    settings, each overridden by the matching flag.
  CREW_SILENT_AFTER Seconds before a box with no tick reads as silent (600).

EXIT STATUS
  0  ok
  1  it went wrong (no box CLI, no roster, incus said no, a guard refused)
  2  you asked wrong (unknown command, bad or missing flag, unknown profile)

EXAMPLES
  # the whole fleet, converged — the verb you run most
  crew up
  crew status

  # one new member, end to end
  crew new claude-builder
  box shell claude-builder          # gh auth login, then the agent login
  crew hire claude-builder

  # a god-view of the fleet, reachable from the LAN
  crew floor --port 8420

  # your own fleet definition, outside the checkout
  crew init
  $EDITOR ~/.config/crew/fleet.roster

  Docs: https://github.com/heavy-duty/crew
EOF
}

# The synopsis and the summary come from the table; only prose lives here, and
# only where a verb has something to say beyond its summary.
help_cmd() {
  echo "usage: $(synopsis_of "$1")"
  echo
  echo "$(field "$1" sum)."
  case "$1" in
    new) cat <<'EOF'

A roster name takes everything from the roster row. --role and --agent make
an ad-hoc box instead, named <agent>-<role> unless --name says otherwise.
--from clones an existing box or one of its snapshots — that is how a gold
image becomes a new member without a second vendor install.

The box is created and nothing else. Log it in by hand, then hire it.
EOF
      ;;
    hire) cat <<'EOF'

Idempotent: a box already carrying this crew's version is skipped, so
hire is safe to re-run and is what 'crew up' calls. --force re-bakes anyway,
and overwrites a box whose engine files were modified by hand (which hire
otherwise refuses, same as upgrade); a development tree (a -dev version)
always re-bakes, because two dev trees at the same version are not the same
code.

--ref names a DIFFERENT engine source, resolved on the host (#99): from a
working tree it is a git ref, and from an installed tree it is one of the
versions under versions/. The box never fetches anything itself.

The guard: hiring an OFF-ROSTER box against the production registry is
refused, because that arms a second production agent racing the fleet for
the same work. Narrow its registry first, add it to the roster, or pass
--allow-offroster if arming production is genuinely what you mean.

'adopt' was this verb's old name and still works.
EOF
      ;;
    up) cat <<'EOF'

The steady-state verb: it creates what is missing, starts what is stopped,
hires what is unhired, and reports who still owes a login. Nothing is ever
deleted — a box on the host but not in the roster is reported and left
alone. --dry-run says what it would do and touches nothing.
EOF
      ;;
    upgrade) cat <<'EOF'

--all means the ROSTER, not every box on the host: a disarmed box carrying a
real identity and a production registry must not be armed by routine
maintenance. Naming a box explicitly still reaches it — that is a deliberate
act on a known target, which --all is not.

A box's armed state is preserved rather than asserted: an upgrade that arms
a box nobody armed is a behaviour change wearing a version bump's clothes.

A box whose engine files no longer match the version they were installed at
is REFUSED, naming what differs, and nothing is written. Somebody patched
that box; this is the last moment anyone can be told before the patch is
overwritten. 'crew status <box>' lists the files. --force overwrites them.
EOF
      ;;
    gold) cat <<'EOF'

Gold images are the bake cache and must carry ZERO credentials, so they are
cut BEFORE the box is logged in. A box with live gh credentials is refused
unless you pass --force, and if you do, treat the result like a credential.
EOF
      ;;
    floor) cat <<'EOF'

The console reads every box over 'box exec' from THIS host and fires operator
actions the same way. Nothing is installed inside a box and no box has to
reach out — the boxes have no inbound path, but the host that runs them has
always had a control channel into them.

It binds 0.0.0.0 by default, because being reachable at IP:PORT is the job.
That makes HTTP Basic auth non-optional: a page that can power-cycle boxes
and start model sessions is not one to leave open on a LAN. Without --pass a
password is generated and printed once, at startup. --local binds loopback
instead, and over plain HTTP on a LAN the password crosses in the clear.

It needs an operator fleet definition and REFUSES under the shipped examples,
like every verb that creates or arms: its buttons resume cron and start model
sessions. 'crew init' scaffolds one; 'crew status' inspects a host without.
--roster selects a roster file, not a fleet — it does not lift the refusal.
EOF
      ;;
    init) cat <<'EOF'

Copies the shipped examples into a fleet definition you own — roster, fleet
config, the two registries, and doctrine paths — and never overwrites an
existing path. Edit them outside the checkout; crew resolves them by
CREW_CONFIG_DIR, then $XDG_CONFIG_HOME/crew, then the working directory,
then the shipped examples.

The login list it prints is a static reading of the roster, not a live
auth check.
EOF
      ;;
    status) cat <<'EOF'

With no box: one row per roster member — state, the engine version it was
hired at, its gh and vendor credential health, and its last duty line. With
a box: that box's engine version and the tail of its duty log.

A box whose duty log has not moved in two tick boundaries reads as stale
rather than flowing. An idle tick is not silent — the engine logs every run
— so silence means no tick RAN, which is a cron problem.
EOF
      ;;
    profiles) cat <<'EOF'

Roles change the engine's duty lifecycle; agent profiles are configuration.
An operator agents/ directory beside the fleet definition overlays the
shipped set, and a same-named profile wins — a profile listed here is
hireable, and one marked [operator] is the operator's copy, not the
shipped one.
EOF
      ;;
  esac
}

show_help() {   # "" → general help
  case "${1:-}" in
    ""|help) usage ;;
    *) is_command "$1" || unknown_command "$1"; help_cmd "$1" ;;
  esac
}

cmd_help() { max_args help 1 "$@"; show_help "$(normalize_verb "${1:-}")"; }

# --- versioned host install -------------------------------------------------
install_root() {
  local versions_dir; versions_dir="$(dirname "$CREW_ROOT")"
  [ "$(basename "$versions_dir")" = versions ] || return 1
  dirname "$versions_dir"
}

crew_bin_links() {
  [ -L "${BASH_SOURCE[0]}" ] && printf '%s\n' "${BASH_SOURCE[0]}"
  [ -n "${CREW_BIN:-}" ] && printf '%s\n' "$CREW_BIN/crew"
  printf '%s\n' "$HOME/.local/bin/crew"
}

link_target() {
  readlink -f "$1" 2>/dev/null ||
    readlink -m "$(dirname "$1")/$(readlink "$1" 2>/dev/null)" 2>/dev/null ||
    true
}

converge_crew_bin_links() {
  local install="$1" link target
  while IFS= read -r link; do
    [ -L "$link" ] || continue
    target="$(link_target "$link")"
    case "$target" in
      "$install"/*) ln -sfn "$install/current/cli/crew" "$link" ;;
    esac
  done < <(crew_bin_links | awk '!seen[$0]++')
}

cmd_versions() {
  max_args versions 0 "$@"
  local install current dir version_name marks
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to list."
  current="$(readlink -f "$install/current" 2>/dev/null || true)"
  echo "VERSIONS  ($install)"
  for dir in "$install"/versions/*/; do
    [ -d "$dir" ] || continue
    version_name="$(basename "$dir")"; marks=""
    [ "$(readlink -f "$dir")" = "$current" ] && marks=" (current)"
    [ "$(readlink -f "$dir")" = "$CREW_ROOT" ] && marks="$marks (running)"
    printf '  %s%s\n' "$version_name" "$marks"
  done
  echo
  echo "switch the default:  crew use <version>"
  echo "install another:     re-run install.sh (versions land side by side)"
}

cmd_use() {
  max_args use 1 "$@"
  [ "$#" -eq 1 ] || usage_error "usage: $(synopsis_of use)"
  local version_name="$1" install effective answer
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to switch."
  valid_version "$version_name" ||
    usage_error "not a sane version name: '$version_name' (see 'crew versions')"
  [ -d "$install/versions/$version_name" ] ||
    die "no such version: $version_name (see 'crew versions')"

  ln -sfn "versions/$version_name" "$install/current.new.$$"
  mv -Tf "$install/current.new.$$" "$install/current"
  converge_crew_bin_links "$install"

  effective="$(basename "$(readlink -f "$install/current" 2>/dev/null || true)")"
  [ "$effective" = "$version_name" ] ||
    die "the switch did not take — current resolves to '${effective:-nothing}', not $version_name"
  answer="$("$install/current/cli/crew" --version 2>&1 || true)"
  case "$answer" in
    "crew $version_name ("*) : ;;
    *) die "current/cli/crew answers '$answer', not version $version_name — the symlink chain is broken" ;;
  esac

  echo "crew: switched to $version_name (current -> versions/$version_name)"
  report_engine_skew "$version_name"
}

uninstall_confirm() {
  local question="$1" forced="$2" reply
  [ "$forced" -eq 1 ] && return 0
  [ -n "${CREW_YES:-}" ] && return 0
  [ -t 0 ] ||
    die "refusing to $question without --force (no terminal to confirm on; CREW_YES=1 also means yes)"
  printf 'crew: %s? [y/N] ' "$question"
  read -r reply || die "aborted."
  case "$reply" in y|Y|yes|YES|Yes) return 0 ;; *) die "aborted." ;; esac
}

live_floor_pids() {
  local floor="$1/fleet-floor/server/floor.py" cmdline argv
  for cmdline in /proc/[0-9]*/cmdline; do
    [ -r "$cmdline" ] || continue
    argv="$(tr '\0' ' ' <"$cmdline" 2>/dev/null || true)"
    case "$argv" in
      *"$floor"*) basename "$(dirname "$cmdline")" ;;
    esac
  done
}

cmd_uninstall() {
  local version_name="" all=0 force=0 arg install current link target leftover=""
  local hired="" floor_pids="" box_name engine
  local removal_targets=()
  for arg in "$@"; do
    case "$arg" in
      --all) all=1 ;;
      --force) force=1 ;;
      -*) usage_error "unknown option '$arg' (usage: $(synopsis_of uninstall))" ;;
      *) [ -z "$version_name" ] ||
           usage_error "usage: $(synopsis_of uninstall)"
         version_name="$arg" ;;
    esac
  done
  install="$(install_root)" ||
    die "this crew runs from a working tree ($CREW_ROOT), not a versioned install — nothing to uninstall."
  [ -w "$install" ] || die "cannot write install root $install"

  if [ -n "$version_name" ] && [ "$all" -eq 0 ]; then
    valid_version "$version_name" ||
      usage_error "not a sane version name: '$version_name' (see 'crew versions')"
    [ -d "$install/versions/$version_name" ] ||
      die "no such version: $version_name (see 'crew versions')"
    current="$(basename "$(readlink -f "$install/current" 2>/dev/null || true)")"
    { [ -n "$current" ] && [ -d "$install/versions/$current" ]; } ||
      die "current is dangling — 'crew use <version>' to repair it before removing anything"
    [ "$version_name" != "$current" ] ||
      die "$version_name is the CURRENT version — 'crew use <other>' first"
    floor_pids="$(live_floor_pids "$install/versions/$version_name")"
    [ -z "$floor_pids" ] ||
      die "version $version_name has a live crew floor (PID(s): $(tr '\n' ' ' <<<"$floor_pids")) — stop that console before uninstalling its tree"
    uninstall_confirm "remove crew version $version_name from $install" "$force"
    rm -rf "$install/versions/$version_name" || true
    if [ -e "$install/versions/$version_name" ] || [ -L "$install/versions/$version_name" ]; then
      echo "crew: uninstall INCOMPLETE — still present: $install/versions/$version_name" >&2
      return 1
    fi
    echo "crew: removed version $version_name (the default stays $current)"
    return 0
  fi
  [ -z "$version_name" ] || usage_error "a version and --all together is ambiguous"
  [ "$all" -eq 1 ] || usage_error "usage: $(synopsis_of uninstall)"

  hired="$(hired_engine_versions)"
  if [ -n "$hired" ] && [ "$force" -eq 0 ] && [ -z "${CREW_YES:-}" ]; then
    {
      echo "crew: refusing to remove the console while hired boxes are running:"
      while IFS=$'\t' read -r box_name engine; do
        echo "crew:   · $box_name ($engine)"
      done <<<"$hired"
      echo "crew: cron is armed inside each box; the fleet keeps running autonomously,"
      echo "crew: unattended, while nothing remains to see, converge, or stop it."
      echo "crew: stop the fleet first with 'crew down', or use --force/CREW_YES=1"
      echo "crew: only if leaving it running unattended is deliberate."
      echo "crew: this removes the console only — box engines are untouched, and"
      echo "crew: 'crew status' is the visibility you are about to lose."
    } >&2
    return 1
  fi
  uninstall_confirm "remove the ENTIRE crew console at $install (every host version)" "$force"

  removal_targets+=("$install")
  while IFS= read -r link; do
    [ -L "$link" ] || continue
    target="$(link_target "$link")"
    case "$target" in "$install"/*) removal_targets+=("$link") ;; esac
  done < <(crew_bin_links | awk '!seen[$0]++')
  mapfile -t removal_targets < <(printf '%s\n' "${removal_targets[@]}" | awk '!seen[$0]++')
  for target in "${removal_targets[@]}"; do rm -rf "$target" || true; done
  for target in "${removal_targets[@]}"; do
    if [ -e "$target" ] || [ -L "$target" ]; then leftover="$leftover $target"; fi
  done
  if [ -n "$leftover" ]; then
    echo "crew: uninstall INCOMPLETE — still present:$leftover" >&2
    return 1
  fi
  echo "crew: uninstalled the host console; box engines were untouched."
}

# EVERY `box exec` in this file takes stdin from /dev/null.
#
# `box exec` forwards stdin the way ssh does, so inside a
# `while read … done < <(read_roster)` the FIRST iteration drained the roster
# FIFO: `read` then hit EOF and the loop exited cleanly, rc=0, with N-1 boxes
# silently missing. `crew status` reported one of three boxes and `crew up`
# converged one box and called it success (#48) — no error either time, which
# is what made it survive a real-host run.
#
# Safe at every call site: all of them pass the script as an ARGUMENT.
# vendor_probe is the one helper that legitimately ships data over stdin, and
# it has its own `<"$(agent_conf "$2")"` redirect — which is exactly why it
# never broke.
#
# Those two are the ONLY places `box exec` appears in this file, and the test
# suite asserts that count. Routing every caller through a helper is what makes
# "stdin is always pinned" checkable at all: before, the redirect was a thing
# each call site had to remember, and the two that forgot were the two in
# roster loops.
bxn() { box exec "$1" -- bash -lc "$2" </dev/null; }

# bxput is the one other stdin-bearing box channel: atomically stage one host
# file without requiring it to be tracked by git in the box's checkout.
bxput() { # BOX SOURCE DESTINATION
  local box_name="$1" source_file="$2" destination="$3" remote_script
  remote_script="
    set -euo pipefail
    destination=\"\$HOME/$destination\"
    mkdir -p \"\$(dirname \"\$destination\")\"
    tmp=\$(mktemp \"\$(dirname \"\$destination\")/.crew-stage.XXXXXX\")
    cat >\"\$tmp\"
    mv \"\$tmp\" \"\$destination\"
  "
  box exec "$box_name" -- bash -lc "$remote_script" <"$source_file"
}

# resolve_engine REF — select one host-side engine source and set the
# ENGINE_* globals consumed by stage_engine. A checkout resolves Git refs;
# an installed tree resolves its current engine or versions/<version>.
# The six failures below split along the same line as the rest of the file
# (codex, round 3 of #106): three are INVOCATION faults and exit 2 — a ref
# whose SHAPE can never be valid, a ref that resolves to nothing, and a ref in
# the wrong form for the mode. Nothing is attempted in any of them. The other
# three exit 1 because the world is wrong rather than the asking: the ref is
# real but its tree has no VERSION, the version directory is missing, or the
# directory's VERSION contradicts its own name.
resolve_engine() {
  local ref="${1:-HEAD}" version_root
  case "$ref" in -*) usage_error "engine ref must not begin with '-': '$ref'" ;; esac
  ENGINE_GIT_REF=""
  if git -C "$CREW_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git -C "$CREW_ROOT" rev-parse --verify "$ref^{commit}" >/dev/null 2>&1 \
      || usage_error "working-tree mode cannot resolve git ref '$ref'"
    ENGINE_VERSION="$(git -C "$CREW_ROOT" show "$ref:VERSION" 2>/dev/null | head -1 | tr -d '\r\n')"
    [ -n "$ENGINE_VERSION" ] || die "working-tree git ref '$ref' has no VERSION"
    ENGINE_MODE="working-tree git ref $ref"
    ENGINE_ROOT="$CREW_ROOT"
    ENGINE_GIT_REF="$ref"
  else
    if [ "$ref" = HEAD ]; then
      version_root="$CREW_ROOT"
      ENGINE_MODE="installed current engine"
    else
      if [[ ! "$ref" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?$ ]]; then
        usage_error "installed-tree mode expects --ref <installed-version>, not '$ref'"
      fi
      version_root="$CREW_ROOT/versions/$ref"
      ENGINE_MODE="installed version $ref"
    fi
    if [ ! -f "$version_root/VERSION" ] || [ ! -d "$version_root/shared" ]; then
      die "$ENGINE_MODE is unavailable under $version_root"
    fi
    ENGINE_VERSION="$(head -1 "$version_root/VERSION" | tr -d '\r\n')"
    [ "$ref" = HEAD ] || [ "$ENGINE_VERSION" = "$ref" ] \
      || die "installed version directory '$ref' contains VERSION '$ENGINE_VERSION'"
    ENGINE_ROOT="$version_root"
  fi
  echo "  engine source: $ENGINE_MODE → crew@$ENGINE_VERSION"
}

# cleanup_staged_engine BOX — best-effort rollback for a failure between the
# engine upload and the install wrapper that normally owns this cleanup.
cleanup_staged_engine() {
  bxn "$1" 'rm -rf ~/.crew-engine-stage ~/.crew-engine.tgz' >/dev/null 2>&1 || true
}

# stage_engine BOX — archive the resolved host engine, atomically upload it,
# and extract it into a disposable box-side staging directory.
stage_engine() {
  local box_name="$1" archive
  archive="$(mktemp)"
  if [ -n "$ENGINE_GIT_REF" ]; then
    if ! git -C "$CREW_ROOT" archive --format=tar.gz \
      --output="$archive" "$ENGINE_GIT_REF" shared VERSION; then
      rm -f "$archive"
      return 1
    fi
  elif ! tar czf "$archive" -C "$ENGINE_ROOT" shared VERSION; then
    rm -f "$archive"
    return 1
  fi
  if ! bxput "$box_name" "$archive" '.crew-engine.tgz'; then
    rm -f "$archive"
    cleanup_staged_engine "$box_name"
    return 1
  fi
  rm -f "$archive"
  # shellcheck disable=SC2016  # expanded by bash inside the box
  if ! bxn "$box_name" '
    set -euo pipefail
    stage="$HOME/.crew-engine-stage"
    archive="$HOME/.crew-engine.tgz"
    cleanup_failed() {
      rc=$?
      if [ "$rc" -ne 0 ]; then rm -rf "$stage" "$archive"; fi
      return "$rc"
    }
    trap cleanup_failed EXIT
    rm -rf "$stage"
    mkdir -p "$stage"
    tar xzf "$archive" -C "$stage"
    test -f "$stage/shared/install.sh"
    test -f "$stage/VERSION"
  '; then
    cleanup_staged_engine "$box_name"
    return 1
  fi
}

# install_staged_engine BOX ARGS — retire the obsolete box-side checkout,
# run the selected host engine, and remove staging on every exit path.
install_staged_engine() {
  local box_name="$1" install_args="$2"
  bxn "$box_name" "
    set -euo pipefail
    stage=\"\$HOME/.crew-engine-stage\"
    archive=\"\$HOME/.crew-engine.tgz\"
    cleanup() { rm -rf \"\$stage\" \"\$archive\"; }
    trap cleanup EXIT
    if [ -e \"\$HOME/crew\" ]; then
      retired=\"\$HOME/crew.retired\"
      if [ -e \"\$retired\" ]; then
        retired=\"\$HOME/crew.retired.\$(date -u '+%Y%m%dT%H%M%SZ')\"
      fi
      mv \"\$HOME/crew\" \"\$retired\"
      echo \"crew: retired obsolete box-side engine source ~/crew to \${retired#\$HOME/}\"
    fi
    \"\$stage/shared/install.sh\" $install_args
  "
}

# stage_agent_profiles BOX — every operator agents/*.conf into the seed dir
# install.sh reads. The seed dir is emptied FIRST even when the operator has
# no agents/ at all: a profile staged by a previous install and since deleted
# from the fleet definition must not resurrect from a stale seed.
#
# The timing is the contract (#75): install.sh refuses an unknown agent
# profile BEFORE it creates conf/agents, so a profile that only arrived with
# the conf copy would fail its own validation — the seed has to be on the box
# before install.sh runs, which is exactly when this stage runs.
stage_agent_profiles() { # BOX
  local box_name="$1" profile
  bxn "$box_name" 'rm -rf ~/duty/.crew-seed-agents' || return 1
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ] && [ -d "$CONFIG_DIR/agents" ]; then
    for profile in "$CONFIG_DIR"/agents/*.conf; do
      if [ -f "$profile" ]; then
        bxput "$box_name" "$profile" "duty/.crew-seed-agents/$(basename "$profile")" || return 1
      fi
    done
  fi
  return 0
}

stage_registry_examples() { # BOX
  local box_name="$1"
  if [ "$CONFIG_IS_OPERATOR" -eq 0 ]; then return 0; fi
  bxput "$box_name" "$CREW_ROOT/examples/repos.txt" \
    'duty/.crew-example-repos.txt' &&
    bxput "$box_name" "$CREW_ROOT/examples/notify-repos.txt" \
      'duty/.crew-example-notify-repos.txt'
}

stage_fleet_definition() { # BOX
  local box_name="$1" runtime_conf
  runtime_conf="$(mktemp)"
  {
    cat "$FLEET_CONF"
    printf '\n# Resolved from the selected fleet directory doctrine.conf.\n'
    cat "$DOCTRINE_CONF"
  } >"$runtime_conf"
  if bxput "$box_name" "$ROSTER" 'duty/fleet.roster' &&
     bxput "$box_name" "$runtime_conf" 'duty/conf/fleet.conf' &&
     bxput "$box_name" "$REPOS_SEED" 'duty/.crew-seed-repos.txt' &&
     bxput "$box_name" "$NOTIFY_REPOS_SEED" 'duty/.crew-seed-notify-repos.txt' &&
     stage_registry_examples "$box_name" &&
     stage_agent_profiles "$box_name"; then
    rm -f "$runtime_conf"
    return 0
  fi
  rm -f "$runtime_conf"
  bxn "$box_name" 'rm -f ~/duty/.crew-seed-repos.txt ~/duty/.crew-seed-notify-repos.txt ~/duty/.crew-example-repos.txt ~/duty/.crew-example-notify-repos.txt; rm -rf ~/duty/.crew-seed-agents' || true
  return 1
}

registry_install_arg() {
  if [ "$CONFIG_IS_OPERATOR" -eq 1 ]; then printf '%s' '--converge-registries'; fi
}

box_names() {
  box list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null \
    || box list 2>/dev/null | awk 'NR>1 {print $1}'
}
box_exists() { box_names | grep -qx "$1"; }

# box_state NAME — the box's lifecycle state, lowercased; "?" when the payload
# cannot be read.
#
# `box info --json` returns an ARRAY. Two call sites filtered it as an object
# (`.state // .status`), so jq died with `Cannot index array with string
# "state"` — and because both were command substitutions under `set -euo
# pipefail`, jq's rc=5 killed the whole command (#47). `crew status` printed
# its header and stopped, which reads like an empty roster rather than a
# crash; `crew up` did the same on the first EXISTING box, and that is the
# steady-state convergence verb. Neither had ever worked on a populated fleet.
#
# `.state` is an object in the real payload, so `.[0].status` must come first.
# The `|| true` and the `${s:-?}` are the parts that matter long-term: a future
# shape change must degrade to "?", not kill the command. box_names makes the
# identical call and survived only because it had a fallback.
box_state() {
  local s
  s="$(box info "$1" --json 2>/dev/null \
    | jq -r 'if type == "array" then (.[0] // {}) else . end
             | .status // (.state | if type == "object" then .status else . end) // "?"' 2>/dev/null \
    | head -1 | tr -d '\r' | tr '[:upper:]' '[:lower:]' || true)"
  printf '%s\n' "${s:-?}"
}

# Roster reader: <name> <agent> <role> [<from-box>/<snap>]; comments/blanks
# skipped. roster_line prints "agent role from" for one name.
read_roster() { grep -vE '^[[:space:]]*(#|$)' "$ROSTER"; }
roster_line() { read_roster | awk -v n="$1" '$1 == n {print $2, $3, $4; exit}'; }
roster_names() { read_roster | awk '{print $1}'; }
install_identity_args() { # NAME AGENT ROLE — shell words for remote install.sh
  if roster_names | grep -qx "$1"; then
    printf "%s" "--box '$1'"
  else
    printf "%s" "--agent '$2' --role '$3'"
  fi
}
# The vendor's own login instruction, for the by-hand step that replaced
# `crew auth`. Falls back to something honest rather than printing nothing.
login_hint() {
  local h
  h="$(sed -n 's/^AGENT_LOGIN_HINT=//p' "$(agent_conf "$1")" 2>/dev/null | tr -d '"')"
  printf '%s\n' "${h:-run the $1 CLI login}"
}

validate_profiles() {  # agent role
  [ -f "$(agent_conf "$1")" ] || usage_error "unknown agent '$1' — see: crew profiles"
  [ -f "$ROLES_DIR/$2.conf" ]  || usage_error "unknown role '$2' — see: crew profiles"
}

# create_box NAME AGENT ROLE [FROM] — infrastructure only, no engine.
create_box() {
  local name="$1" agent="$2" role="$3" from="${4:-}"
  local BOX_CPU="" BOX_MEMORY="" BOX_DISK=""
  # shellcheck disable=SC1090
  source "$ROLES_DIR/$role.conf"
  if [ -z "$BOX_CPU" ] || [ -z "$BOX_MEMORY" ] || [ -z "$BOX_DISK" ]; then
    die "role '$role' declares no BOX_CPU/BOX_MEMORY/BOX_DISK"
  fi
  # </dev/null on both: create_box runs inside the create-all and up roster
  # loops, which read from a FIFO any stdin-inheriting `box` call would drain
  # (#48). Neither form takes input — every argument is on the command line.
  # A CLONE carries its source's resources, and `box new --from` REFUSES the
  # sizing flags outright: "--cpu/--memory/--disk shape a fresh mint; a clone
  # carries its source's resources ('box incus' can change them afterwards)".
  # Passing them here meant every roster line with a 4th-column gold snapshot
  # died at `crew new`/`crew create-all`. Never noticed because no roster line
  # has ever carried one — the same never-exercised-path shape as #47 and #48.
  #
  # The role profile's sizing therefore does NOT apply to a cloned box, which
  # is a real semantic and not a detail to swallow: a builder minted from a
  # reviewer-sized gold comes up with the reviewer's 2 CPU / 4GiB. Said out
  # loud here so an operator can resize rather than discover it under load.
  if [ -n "$from" ]; then
    echo "creating $name  (role=$role agent=$agent from=$from)"
    echo "  note: a clone inherits $from's cpu/memory/disk — the $role profile's"
    echo "        $BOX_CPU cpu / $BOX_MEMORY / $BOX_DISK does NOT apply (resize with: box incus)"
    box new --name "$name" --from "$from" </dev/null
  else
    echo "creating $name  (role=$role agent=$agent cpu=$BOX_CPU mem=$BOX_MEMORY disk=$BOX_DISK template=$agent-box)"
    box new --name "$name" --template "$agent-box" --cpu "$BOX_CPU" --memory "$BOX_MEMORY" --disk "$BOX_DISK" </dev/null
  fi
}

# box_agent NAME — the agent the box was ACTUALLY installed as, per the
# instance.conf install.sh wrote. Empty on an unhired box. Parsed rather than
# sourced: one string is not worth executing a config for.
#
# `|| true` is load-bearing, exactly as it is in box_state: under `set -o
# pipefail` this pipeline takes bxn's status, so an unreachable box made
# `actual="$(box_agent …)"` fail and `set -e` killed the whole status loop —
# after four of six rows, which is the same silent-truncation shape as #48.
box_agent() {
  bxn "$1" 'sed -n "s/^BOT_AGENT=//p" ~/duty/conf/instance.conf 2>/dev/null | head -1' 2>/dev/null \
    | tr -d '"'\''\r\n' || true
}

# engine_report NAME [--paths] — ONE exec: which engine this box carries, and
# whether its files are still that engine (#159).
#
# Both facts on the same round trip because `crew status` needs both on every
# row and the budget was explicit: no additional round trip per box. This
# replaces the bare `head -1 ~/duty/VERSION` that hired_at used to make, so the
# fleet table costs exactly what it cost before.
#
# Emits key=value lines:
#     state=current|modified|unverified|absent
#     stamp=<the ~/duty/VERSION first line>
#     recorded=<the stamp the engine manifest was recorded at>
#     path=<modified|added|removed> <relpath>     (--paths, when modified)
#
# key=value rather than one delimited record on purpose: a TAB-joined line read
# back with `read -r a b c` collapses an empty field into the next one, and the
# empty field here — `recorded=` on an unverified box — is the common case
# until the fleet has upgraded once.
engine_report() {
  local name="$1" paths="${2:-}"
  # shellcheck disable=SC2016  # $HOME must expand INSIDE the box
  bxn "$name" '
    if [ -x "$HOME/duty/bin/engine-manifest.sh" ]; then
      "$HOME/duty/bin/engine-manifest.sh" --report '"$paths"'
    else
      # An engine installed before content stamping ships no tool to compute
      # an engine manifest and recorded none. That is UNVERIFIED, never
      # modified: a fleet that reads modified everywhere on the day this lands
      # has learned that the word means nothing. One upgrade cures it.
      if [ -s "$HOME/duty/VERSION" ]; then echo state=unverified; else echo state=absent; fi
      echo "stamp=$(head -1 "$HOME/duty/VERSION" 2>/dev/null)"
      echo recorded=
    fi
  ' 2>/dev/null | tr -d '\r' || true
}

# report_field KEY REPORT — one value out of an engine_report capture.
report_field() { printf '%s\n' "$2" | sed -n "s/^$1=//p" | head -1; }

# hired_at NAME — the raw first-line engine stamp, if any. Keep this raw for
# status and provenance; comparisons go through stamp_version below.
hired_at() { report_field stamp "$(engine_report "$1")"; }

# stamp_version STAMP — print the version from a current-format stamp.
# SHA-only legacy stamps deliberately fail to parse: they still prove the box
# is hired, but cannot compare equal to a version and therefore re-bake once.
stamp_version() {
  local stamp="${1:-}" version
  case "$stamp" in
    crew@*) version="${stamp#crew@}"; version="${version%% *}" ;;
    *) return 1 ;;
  esac
  if [[ "$version" =~ ^[0-9]+\.[0-9]+\.[0-9]+(-[A-Za-z0-9][A-Za-z0-9.-]*)?$ ]]; then
    printf '%s\n' "$version"
  else
    return 1
  fi
}

# vendor_probe NAME AGENT — run the agent profile's bot_cli_probe inside the
# box, shipping the profile over stdin (works on unhired boxes too).
vendor_probe() {
  box exec "$1" -- bash -lc \
    'cat >/tmp/.crew-agent-probe.conf; source /tmp/.crew-agent-probe.conf; bot_cli_probe' \
    <"$(agent_conf "$2")" >/dev/null 2>&1
}

# auth_from_flow NAME — the box's credential state as the DUTY ENGINE last
# observed it, in one exec of pure local file reads. Echoes five fields:
#
#     <gh-state> <vendor-state> <tick-age-seconds-or--1> <armed> <paused>
#
# `armed` and `paused` are crontab line COUNTS, read with probe.sh's own
# patterns, so `crew status` and the floor answer "is this box armed?" from
# one source instead of two (#189: the floor called every unarmed box SILENT,
# and the CLI could not answer the question at all).
#
# where a state is flowing | stale | missing | unknown, the same vocabulary
# fleet-floor's probe.sh emits — including `stale`, which is the difference
# between an engine that is INSTALLED and one that is RUNNING. VERSION alone
# proves only the first, so a disarmed box with a dead token reported
# `flowing` until this required a recent tick too.
#
# The box reports the tick AGE and this host applies the rule, exactly as the
# floor does with probe.sh's ::tickage. A threshold baked into the in-box
# script would be a third copy of a number floor.py derives from TICK_S, and
# the drill asserts these two readers agree — so a drift here fails it for a
# reason nobody would connect to a constant.
#
# This deliberately does NOT call `gh auth status` or bot_cli_probe. Those
# reach the network, and — more importantly — they are a SECOND source of
# truth. `rehearsal-app.sh` asserts the floor and this CLI agree about every
# box, on the grounds that a disagreement means one of them is lying to an
# operator; that only holds while both read the same evidence. When the floor
# stopped polling credentials and started reading what the engine records,
# leaving `crew status` probing live would have manufactured exactly the
# disagreement the drill exists to catch — a box whose token died four
# minutes ago reading MISSING here and `flowing` there.
#
# Live probing survives where it belongs: `crew hire` and the boot gate pay
# for certainty once, at the moment someone is standing there to fix it.
auth_from_flow() {
  # shellcheck disable=SC2016  # $HOME and $svc must expand INSIDE the box
  bxn "$1" '
    for svc in gh vendor; do
      if [ -s "$HOME/duty/.auth-fail.$svc" ]; then printf "missing "
      elif [ ! -s "$HOME/duty/VERSION" ]; then printf "unknown "
      else printf "nofail "; fi
    done
    age=-1
    if [ -r "$HOME/duty/duty.log" ]; then
      ts="$(grep -oE "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z" "$HOME/duty/duty.log" | tail -1)"
      [ -n "$ts" ] && age=$(( $(date -u +%s) - $(date -u -d "$ts" +%s 2>/dev/null || echo 0) ))
    fi
    # Live tick.sh crontab lines. The pattern is probe.sh'\''s ::cron pattern
    # CHARACTER FOR CHARACTER, and it has to stay that way: this helper exists
    # because a CLI and a floor holding private sources of truth disagree in
    # front of an operator, and a private PATTERN is that defect wearing a
    # smaller hat — a box would read armed here and disarmed there.
    #
    # NO `||` guard, and that is deliberate. grep -c PRINTS the count and then
    # exits 1 when it is zero; `|| echo 0` appends a SECOND zero on a new line,
    # which pushes every later field off the line the caller reads. It shipped
    # that way for one review round: a paused box emitted "… 0\n0 1", `read`
    # saw only line 1, and the operator was told to `crew hire` a box they had
    # just paused — the precise outcome the comment below claims to prevent.
    # Nothing here runs under `set -e`, so the exit status is inert; the count
    # on stdout is the whole answer. probe.sh carries no guard either, which is
    # what makes the CHARACTER FOR CHARACTER claim above true.
    armed="$(crontab -l 2>/dev/null | grep -cE "^[^#].*tick\.sh")"
    # Both counts, because "not armed" has two causes with two different fixes:
    # the console'\''s Pause comments the line out (resume it), and an unarmed
    # box never had one (crew hire it). Telling an operator to re-hire a box
    # they paused thirty seconds ago is worse than saying nothing.
    paused="$(crontab -l 2>/dev/null | grep -cE "^#[[:space:]]*CREW-FLOOR-PAUSED")"
    printf "%s %s %s\n" "$age" "$armed" "$paused"
    printf "\n"
  ' 2>/dev/null | tr -d '\r'
}

# production_registry — the repo list THIS checkout would seed into a box.
production_registry() {
  # `|| true` is load-bearing, as in box_state/box_agent/box_registry: an EMPTY
  # or all-comment registry makes grep exit 1, pipefail takes that status, and
  # `prod="$(production_registry)"` in hire_guard then dies under set -e with
  # no message at all.
  grep -vE '^[[:space:]]*(#|$)' "$REPOS_SEED" | sort || true
}
# box_registry NAME — the repos.txt the box actually carries, or empty when it
# has none yet (install.sh seeds the production default in that case).
box_registry() {
  bxn "$1" 'grep -vE "^[[:space:]]*(#|\$)" ~/duty/repos.txt 2>/dev/null' 2>/dev/null \
    | tr -d '\r' | sort || true
}

# fleet_static_identities — GitHub logins declared by the selected fleet.
# The roster names boxes and vendor profiles, not GitHub accounts, so its live
# identities are added separately below. Keep the source in a subshell: an
# operator fleet.conf is trusted configuration, but it must not overwrite this
# host CLI's state while we read three values from it.
fleet_static_identities() (
  FLEET_BENCH="" FLEET_TRIAGE="" FLEET_HUMAN=""
  # shellcheck disable=SC1090  # selected operator/shipped config, resolved above
  source "$FLEET_CONF"
  printf '%s\n' "$FLEET_BENCH" "$FLEET_TRIAGE" "$FLEET_HUMAN" | tr ' ' '\n'
)

# fleet_identities — configured participants plus authenticated roster boxes.
# A newly-created or logged-out box contributes nothing; the static bench and
# triage declarations still make detection useful before the whole fleet is up.
fleet_identities() {
  local name
  fleet_static_identities
  while read -r name; do
    if box_exists "$name"; then
      bxn "$name" 'gh api user --jq .login 2>/dev/null' 2>/dev/null | tr -d '\r' || true
    fi
  done < <(roster_names)
}

# foreign_actor_check — notice a likely second fleet on one of our boards.
# GitHub's repository event feed is shared board state, not a connection to
# another fleet. This deliberately warns after the fact and returns success:
# only operators decide which fleet keeps a repo, and this path never writes a
# registry (crew#70, option 2).
foreign_actor_check() {
  local allowed repo events parsed jq_err_file jq_err finding action actor
  allowed="$(fleet_identities | sed '/^$/d' | sort -u)"

  while read -r repo; do
    if ! events="$(gh api -X GET "repos/$repo/events?per_page=100" 2>/dev/null)"; then
      echo "crew: NOTE one-repo-one-fleet: could not inspect recent board activity for $repo; overlap detection skipped" >&2
      continue
    fi
    jq_err_file="$(mktemp)"
    if ! parsed="$(printf '%s' "$events" | jq -r '
      .[] |
      if .type == "IssuesEvent" and .payload.action == "assigned" then
        ["claim", (.payload.assignee.login // .actor.login)]
      elif .type == "IssuesEvent" and .payload.action == "opened" then
        ["mint", .actor.login]
      elif .type == "PullRequestReviewEvent"
           and ((.payload.review.state // "") | ascii_downcase)
               as $state
           | ($state == "approved" or $state == "changes_requested") then
        ["verdict", .actor.login]
      else empty end |
      select(.[1] != null) | @tsv
    ' 2>"$jq_err_file")"; then
      jq_err="$(<"$jq_err_file")"
      rm -f "$jq_err_file"
      echo "crew: NOTE one-repo-one-fleet: unreadable recent board activity for $repo ($jq_err); overlap detection skipped" >&2
      continue
    fi
    rm -f "$jq_err_file"
    [ -n "$parsed" ] || continue
    finding="$(while IFS=$'\t' read -r action actor; do
      if ! grep -Fxq "$actor" <<<"$allowed"; then
        printf '%s\t%s\n' "$action" "$actor"
        break
      fi
    done <<<"$parsed")"
    [ -n "$finding" ] || continue
    IFS=$'\t' read -r action actor <<<"$finding"
    echo "crew: WARN one-repo-one-fleet: foreign $action by @$actor in registered repo $repo indicates another fleet may also govern it." >&2
    echo "crew: WARN registries LEFT UNCHANGED — the operators must decide which fleet keeps $repo." >&2
  done < <(production_registry)
}

# hire_guard NAME ALLOW_OFFROSTER — refuse to arm an OFF-ROSTER box against the
# production registry. Always prints the registry it is about to arm against.
#
# `crew hire` on a leftover crew-drill-* box turned it into a SECOND production
# agent, with nothing in the path saying so (#51). The drill's teardown had
# worked correctly — it restored the pre-drill repos.txt, and "pre-drill" IS
# the shipped registry example — and install.sh correctly left that registry
# alone, because seeding only happens when the file is absent. So a hand-hire
# to re-arm the box armed cron against production, and within one tick a drill
# box was doing author-side duty on a real repo under the same identity as the
# real fleet, racing it for the same work. That tick was benign. The next need
# not be.
#
# The test is STRUCTURAL rather than a name convention (#51's third bullet):
# roster membership, plus the registry the box will actually work. That reaches
# an ad-hoc box called anything at all, and it lets a genuine drill box be
# hired the moment its registry is a sandbox — which is the state
# drill/rehearsal.sh leaves it in while it runs. `crew upgrade --all` already
# draws this same line for the same reason (#37).
hire_guard() {
  local name="$1" allow="$2" reg prod
  prod="$(production_registry)"
  reg="$(box_registry "$name")"
  if [ -z "$reg" ]; then
    echo "  registry: none yet — install.sh will seed the production default"
    reg="$prod"
  else
    echo "  registry: $(printf '%s' "$reg" | tr '\n' ' ')"
  fi
  if roster_names | grep -qx "$name"; then return 0; fi
  if [ "$reg" != "$prod" ]; then return 0; fi
  if [ "$allow" -eq 1 ]; then
    echo "  NOTE: $name is off-roster and carries the PRODUCTION registry — arming anyway (--allow-offroster)"
    return 0
  fi
  die "$name is not in $ROSTER, and hiring it would arm it against the PRODUCTION registry:
    $(printf '%s' "$prod" | tr '\n' ' ')
  That makes it a second production agent racing the fleet for the same work (#51).
  Narrow its registry first (for a drill box, drill/rehearsal.sh does exactly that),
  add it to the roster, or pass --allow-offroster if arming production is what you mean."
}

# hire_box NAME AGENT ROLE REF FORCE [ALLOW_OFFROSTER] — bake + arm; release
# versions skip when already installed, while development versions re-bake.
hire_box() {
  local name="$1" agent="$2" role="$3" ref="$4" force="$5" allow="${6:-0}"
  local want have have_version identity_args registry_arg
  identity_args="$(install_identity_args "$name" "$agent" "$role")"
  registry_arg="$(registry_install_arg)"
  # The engine is resolved ONCE by the calling verb, at parse time, not here
  # per box. Resolving inside this loop meant a malformed --ref was validated
  # LAZILY: `crew hire-all --ref -bad` against an empty roster never reached
  # this line and exited 0, and `crew hire nosuchbox --ref -bad` died on the
  # missing box first. A malformed invocation must be refused before any state
  # is consulted (found by this PR's own regression assertion, round 3). It
  # also stops re-running `git rev-parse` once per box.
  want="$ENGINE_VERSION"
  # The guard runs BEFORE the already-hired shortcut: a box that is already
  # armed against the wrong registry is precisely the state an operator needs
  # told about, and "skipping" would hide it.
  hire_guard "$name" "$allow"
  have="$(hired_at "$name")"
  have_version="$(stamp_version "$have" 2>/dev/null || true)"
  if [[ "$want" == *-dev* ]]; then
    echo "$name: crew@$want is a development tree — re-baking even when the installed version matches"
  elif [ "$force" -eq 0 ] && [ "$have_version" = "$want" ]; then
      echo "$name: already hired at $have — version $want matches, skipping"
      return 0
  fi
  echo "hiring $name  (role=$role agent=$agent crew@$want)"
  # --force already meant "re-install even when the version matches"; it now
  # also carries through install.sh's refusal to overwrite a MODIFIED engine
  # (#159). One flag, one meaning: install over what is there regardless.
  # An `if`, not `[ … ] && …`: under set -e that form kills the function
  # whenever force is 0, the same shape as the note in cmd_upgrade's loop.
  local force_arg=""
  if [ "$force" -eq 1 ]; then force_arg="--force"; fi
  if ! stage_engine "$name" ||
     ! stage_fleet_definition "$name" ||
     ! install_staged_engine "$name" "$identity_args $registry_arg --arm-cron $force_arg"; then
    cleanup_staged_engine "$name"
    echo "$name: hire FAILED — the engine is NOT installed and cron is NOT armed (output above)"
    return 1
  fi
  if bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "$name: hired — on duty at the next 5-minute boundary"
  else
    echo "$name: hired but NOT authenticated — it idles loudly until you log it in: box shell $name → gh auth login"
  fi
}

cmd_new() {
  need_box
  local role="" agent="" name="" from=""
  # Positional first argument = a roster name.
  if [ $# -gt 0 ]; then
    case "$1" in --*) : ;; *) name="$1"; shift ;; esac
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  need_value "$@"; role="$2";  shift 2 ;;
      --agent) need_value "$@"; agent="$2"; shift 2 ;;
      --name)  need_value "$@"; name="$2";  shift 2 ;;
      --from)  need_value "$@"; from="$2";  shift 2 ;;
      *) usage_error "unknown argument '$1' (usage: crew new <roster-name> | crew new --role <r> --agent <a> [--name <n>] [--from <box>/<snap>])" ;;
    esac
  done
  if [ -n "$name" ] && [ -z "$role$agent" ]; then
    local line
    line="$(roster_line "$name")"
    [ -n "$line" ] || usage_error "'$name' is not in $ROSTER (or pass --role/--agent for an ad-hoc box)"
    read -r agent role from <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then usage_error "usage: crew new <roster-name> | crew new --role <r> --agent <a>"; fi
  validate_profiles "$agent" "$role"
  require_operator_config "crew new"
  if [ -z "$name" ]; then
    name="$agent-$role"
    local i=2
    while box_exists "$name"; do name="$agent-$role-$i"; i=$((i + 1)); done
  fi
  box_exists "$name" && die "'$name' already exists (crew hire $name to put it on duty)"

  create_box "$name" "$agent" "$role" "$from"
  cat <<EOF

$name is created — vendor CLI converging via the $agent-box template; no
engine, no cron: it does nothing until hired. Next, once per box, ever:

  box shell $name        # then, inside the box:
                         #   gh auth login
                         #   $(login_hint "$agent")
  crew hire $name        # joins the crew; on duty at the next 5-min boundary

(a NEW GitHub identity per box; for a reviewer decide the panel= changes first)
EOF
  return 0
}

cmd_create_all() {
  max_args create-all 0 "$@"
  need_box
  require_operator_config "crew create-all"
  local name agent role from made=0 existing=0 failed=0 failed_names=""
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    if box_exists "$name"; then
      echo "$name: exists"
      existing=$((existing + 1))
    else
      if create_box "$name" "$agent" "$role" "$from"; then
        made=$((made + 1))
      else
        failed=$((failed + 1))
        failed_names="${failed_names}${failed_names:+, }$name"
      fi
    fi
  done < <(read_roster)
  echo
  if [ "$failed" -eq 0 ] && [ "$existing" -eq 0 ]; then
    echo "$made created. Next: log each new box in by hand (box shell <box> → gh auth login; the worst part,"
  else
    echo "create-all: $made created, $existing existing, $failed failed${failed_names:+ ($failed_names)}."
    echo "Next: log each new box in by hand (box shell <box> → gh auth login; the worst part,"
  fi
  echo "halved: GitHub is automated), then 'crew hire-all'."
  if [ "$failed" -ne 0 ]; then return 1; fi
}

cmd_hire() {
  need_box
  local name="${1:-}"; shift || true
  case "$name" in ""|--*) usage_error "usage: $(synopsis_of hire)" ;; esac
  local role="" agent="" ref="HEAD" force=0 allow=0 explicit_profile=0 line=""
  local roster_agent="" roster_role=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  need_value "$@"; role="$2";  explicit_profile=1; shift 2 ;;
      --agent) need_value "$@"; agent="$2"; explicit_profile=1; shift 2 ;;
      --ref)   need_value "$@"; ref="$2";   shift 2 ;;
      --force) force=1;    shift ;;
      # Deliberately NOT --force: that means "re-bake an already-hired box",
      # and overloading it would let a routine re-bake wave the registry check
      # through as a side effect (#51).
      --allow-offroster) allow=1; shift ;;
      *) usage_error "unknown argument '$1'" ;;
    esac
  done
  resolve_engine "$ref"
  require_operator_config "crew hire"
  box_exists "$name" || die "no box named '$name' — crew new $name first"
  line="$(roster_line "$name")"
  if [ -n "$line" ] && [ "$explicit_profile" -eq 1 ]; then
    read -r roster_agent roster_role _ <<<"$line"
    usage_error "$name is declared as agent=$roster_agent role=$roster_role in $ROSTER; remove --agent/--role (the roster in force is authoritative)"
  fi
  if [ -z "$role$agent" ]; then
    [ -n "$line" ] || usage_error "'$name' is not in $ROSTER — pass --role and --agent"
    read -r agent role _ <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then usage_error "--role and --agent go together"; fi
  validate_profiles "$agent" "$role"
  foreign_actor_check
  hire_box "$name" "$agent" "$role" "$ref" "$force" "$allow"
}

cmd_hire_all() {
  need_box
  # Beyond codex's list, same class and one step worse: an unknown flag was
  # SILENTLY IGNORED here, so `crew hire-all --dry-run` hired the whole fleet
  # while reading like a rehearsal. The table now declares this verb's
  # synopsis, so anything else is malformed and says so.
  local ref="HEAD"
  if [ "$#" -gt 0 ]; then
    case "$1" in
      --ref) need_value "$@"; ref="$2"; shift 2 ;;
      *) usage_error "unknown argument '$1' (usage: $(synopsis_of hire-all))" ;;
    esac
    [ "$#" -eq 0 ] || usage_error "usage: $(synopsis_of hire-all)"
  fi
  resolve_engine "$ref"
  require_operator_config "crew hire-all"
  local name agent role _from hired=0 failed=0
  foreign_actor_check
  while read -r name agent role _from; do
    validate_profiles "$agent" "$role"
    if ! box_exists "$name"; then
      echo "$name: not created — crew new $name first"
      continue
    fi
    # An `if`, not a bare call: crew's top-level `set -e` used to kill
    # hire-all on the first failing box, so one failed engine convergence
    # blocked the ENTIRE fleet (#49). A fleet verb reports what it could not
    # do and carries on; the summary below is what makes the failure loud.
    if hire_box "$name" "$agent" "$role" "$ref" 0; then
      hired=$((hired + 1))
    else
      failed=$((failed + 1))
    fi
  done < <(read_roster)
  echo
  echo "hire-all: $hired hired, $failed failed"
  if [ "$failed" -ne 0 ]; then return 1; fi
}

cmd_up() {
  need_box
  # Same silently-ignored-flag defect as hire-all above: `crew up --dry-run`
  # is the ONLY accepted form, and anything else used to converge the fleet
  # without a word.
  local dry=0
  if [ "$#" -gt 0 ]; then
    case "$1" in
      --dry-run) dry=1; shift ;;
      *) usage_error "unknown argument '$1' (usage: $(synopsis_of up))" ;;
    esac
    [ "$#" -eq 0 ] || usage_error "usage: $(synopsis_of up)"
  fi
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  # --dry-run is a read: it is exactly how an operator inspects a host that has
  # no configuration yet, so it keeps working and carries the banner. The
  # converging form creates boxes and arms cron, so it refuses.
  if [ "$dry" -eq 1 ]; then fallback_banner; else require_operator_config "crew up"; fi

  # `up` takes no --ref, but hire_box now consumes the globals the caller
  # resolves — so it resolves HEAD once here, for the same reason and with the
  # same "once, not per box" property.
  resolve_engine HEAD
  local name agent role from state failed=0
  foreign_actor_check
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    if ! box_exists "$name"; then
      if [ "$dry" -eq 1 ]; then echo "$name: WOULD create ($agent/$role${from:+ from $from})"; continue; fi
      create_box "$name" "$agent" "$role" "$from"
    else
      state="$(box_state "$name")"
      if [ "$state" = "stopped" ]; then
        # `box start` in a roster loop gets the same /dev/null as bxn: any
        # `box` subcommand that inherits stdin can drain the FIFO this loop is
        # reading from (#48).
        if [ "$dry" -eq 1 ]; then echo "$name: WOULD start"; else box start "$name" </dev/null; echo "$name: started"; fi
      fi
    fi
    if [ "$dry" -eq 0 ]; then
      # Same reasoning as hire-all: one box must not abort the convergence.
      if ! hire_box "$name" "$agent" "$role" HEAD 0; then failed=$((failed + 1)); fi
    else
      echo "$name: WOULD hire (currently: $(hired_at "$name"))" 2>/dev/null || echo "$name: WOULD hire"
    fi
  done < <(read_roster)

  if [ "$dry" -eq 0 ] && [ "$failed" -ne 0 ]; then
    echo
    echo "up: $failed box(es) could NOT be hired — see the errors above"
  fi

  if [ "$dry" -eq 0 ]; then
    echo
    echo "auth:"
    while read -r name _agent _role _from; do
      if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
        echo "  $name: logged in"
      else
        echo "  $name: AWAITING LOGIN  (box shell $name → gh auth login)"
      fi
    done < <(read_roster)
    echo
    echo "boxes on this host but not in the roster (left alone):"
    comm -23 <(box_names | sort) <(roster_names | sort) | sed 's/^/  /' || true
  fi
  # Convergence that could not converge must not exit 0: `crew up` is what
  # automation runs, and a success rc is the only thing most callers read.
  if [ "$dry" -eq 0 ] && [ "$failed" -ne 0 ]; then return 1; fi
}

cmd_down() {
  max_args down 0 "$@"
  need_box
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  require_operator_config "crew down"
  local name _rest
  while read -r name _rest; do
    if box_exists "$name"; then
      # </dev/null for the same reason as bxn: this loop reads from a FIFO
      # a stdin-inheriting `box` subcommand would drain (#48).
      box down "$name" </dev/null || echo "  down FAILED on $name"
    else
      echo "  $name: not present, skipping"
    fi
  done < <(read_roster)
}

# crew status — no argument: the whole crew as a table, one roster member
# per row, with auth problems FLAGGED (an unauthenticated member fails
# loudly in its own duty.log every tick; this is the host-side view of the
# same fact). With a box name: the detailed view.
cmd_status() {
  max_args status 1 "$@"
  need_box
  fallback_banner
  if [ -n "${1:-}" ]; then
    local b="$1" engine
    # A box that does not exist is a FAILURE, not an empty report (#97). The
    # old form printed "(unreachable)" and returned 0, so `crew status x ||
    # alert` could never fire and a typo'd box name read exactly like a box
    # that was merely down. Same shape as cmd_hire's existing check, and the
    # same exit code: the world is not ready, so 1 rather than 2.
    #
    # Deliberately narrow: a box that EXISTS but does not answer keeps
    # printing "(unreachable)" and returning 0, because stopped is a normal
    # state that `crew status` with no argument reports without complaint.
    box_exists "$b" || die "no box named '$b' — 'crew status' lists the roster"
    echo "== $b"
    echo "host: $(crew_version)"
    # The same single exec the table makes, asked for its paths as well: this
    # is the view an operator opens after the table shouted MODIFIED, so it is
    # where the file list belongs. Still one round trip, not two.
    local report state recorded
    report="$(engine_report "$b" --paths)"
    engine="$(report_field stamp "$report")"
    state="$(report_field state "$report")"
    recorded="$(report_field recorded "$report")"
    echo "engine: ${engine:-not hired (no engine)}"
    case "$state" in
      current)
        echo "integrity: current — every engine file is what ${recorded:-this install} shipped" ;;
      modified)
        # Named separately from skew, and worded differently, because they ask
        # for different actions: skew says "ship the engine", MODIFIED says
        # "find out what someone did here, and why".
        echo "integrity: MODIFIED — diverged from ${recorded:-its recorded install}:"
        printf '%s\n' "$report" | sed -n 's/^path=/  /p'
        echo "  crew upgrade $b --force overwrites all of these — save what you need first" ;;
      unverified)
        echo "integrity: unverified — hired before content stamping; the next crew upgrade records one" ;;
    esac
    bxn "$b" 'tail -n 5 ~/duty/duty.log 2>/dev/null' 2>/dev/null ||
      echo "  (unreachable)"
    return 0
  fi

  # 20, not 18: `crew-drill-reviewer` is 19 characters, so an 18-wide column
  # overflowed and shifted every field after it one place right on that row.
  #
  # INTEGRITY is its OWN column and not a decoration on ENGINE (#159): HOST vs
  # ENGINE is skew, INTEGRITY is whether the box is even running the engine it
  # names, and collapsing the two loses the only question `crew status` could
  # not answer before. 10 wide for `unverified`.
  local fmt='%-20s %-9s %-12s %-15s %-10s %-8s %-8s %s\n'
  local host; host="$(crew_version)"
  # shellcheck disable=SC2059
  printf "$fmt" MEMBER STATE HOST ENGINE INTEGRITY GH VENDOR NOTE
  local name agent role _from state hired ghs vs ghs_d vs_d note last
  local report estate erecorded edisplay
  while read -r name agent role _from; do
    if ! box_exists "$name"; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" - "$host" - - - - "NOT CREATED — crew new $name"
      continue
    fi
    state="$(box_state "$name")"
    if [ "$state" = "stopped" ]; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" stopped "$host" - - - - "crew up starts it"
      continue
    fi
    report="$(engine_report "$name")"
    hired="$(report_field stamp "$report")"
    estate="$(report_field state "$report")"
    erecorded="$(report_field recorded "$report")"
    # One exec, no network, same evidence the floor reads — see auth_from_flow.
    read -r ghs vs tickage armed cpaused <<<"$(auth_from_flow "$name")"
    ghs="${ghs:-unknown}"; vs="${vs:-unknown}"; tickage="${tickage:--1}"
    # An older engine, or a box that answered nothing, reports no counts. Treat
    # that as "armed" rather than inventing an alarm: absence of evidence about
    # cron is not evidence that cron is gone, and the old behaviour (say
    # nothing) is the safe one to fall back to.
    armed="${armed:-1}"; cpaused="${cpaused:-0}"
    # `nofail` aged into a verdict HERE, on the host, with the same rule the
    # floor applies. SILENT_AFTER_S must equal floor.py's; shared/test asserts
    # it, because two readers with private thresholds is the defect this whole
    # helper exists to remove.
    for _v in ghs vs; do
      if [ "${!_v}" = nofail ]; then
        if [ "$tickage" -ge 0 ] && [ "$tickage" -lt "$SILENT_AFTER_S" ]; then
          printf -v "$_v" flowing
        else
          printf -v "$_v" stale
        fi
      fi
    done
    # The wire vocabulary is lowercase and shared with the floor; the TABLE
    # shouts. A dead login is the one row an operator must not skim past, and
    # it earned its capitals long before this column changed source.
    ghs_d="$ghs"; vs_d="$vs"
    [ "$ghs" = missing ] && ghs_d=MISSING
    [ "$vs"  = missing ] && vs_d=MISSING
    note=""
    [ -z "$hired" ] && { hired="not hired"; note="crew hire $name"; }
    if [ "$ghs" = missing ] || [ "$vs" = missing ]; then
      note="⚠ log in: box shell $name${note:+; $note}"
      # A failing vendor probe has two very different causes, and they were
      # indistinguishable: the box is genuinely logged out, OR the ROSTER named
      # the wrong agent and we just probed with the wrong vendor profile. The
      # second reads as the first forever, because nothing compared the
      # roster's claim against what the box was actually installed as.
      #
      # Only asked when the probe already failed: on a healthy fleet this costs
      # nothing, and this is exactly the moment an operator is staring at
      # MISSING wondering why. (A mismatch where BOTH vendor CLIs happen to be
      # installed stays invisible here; the floor reports it unconditionally,
      # since probe.sh is one round trip either way.)
      if [ "$vs" = MISSING ]; then
        actual="$(box_agent "$name")"
        if [ -n "$actual" ] && [ "$actual" != "$agent" ]; then
          note="⚠ $ROSTER says '$agent', box installed as '$actual' — probing the WRONG vendor"
        fi
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ] && [ "$armed" = 0 ]; then
      # Not armed: cron will never fire here, so the newest duty.log line is a
      # fact about the past and reads as though the box is working. The floor
      # says the same thing from the same counts (#189) — that agreement is the
      # point, and drill/rehearsal-app.sh asserts it on a real host.
      if [ "$cpaused" != 0 ]; then
        note="paused by operator — resume from the console"
      else
        note="disarmed — no cron line; crew hire $name arms it"
      fi
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ]; then
      # `|| true` is load-bearing, exactly as it is in box_state, box_agent and
      # box_registry: ~/duty/duty.log does not exist until the first duty run
      # writes it, so `tail` exits 1, bxn propagates that, `pipefail` takes it,
      # and the assignment died under `set -e` — killing the table at the first
      # never-ticked box with no message at all (#224). That is not an edge
      # case during bring-up: it is EVERY box, for the first five minutes.
      #
      # It also makes `no ticks yet` reachable. The fallback was written for
      # exactly this box and could never render, because the assignment that
      # would leave `last` empty ended the command first.
      #
      # An UNREACHABLE box never arrives here: it answers no engine_report, so
      # `hired` is empty and the branch above claims the row. That separation
      # is the point — a box nobody can talk to must not read as a healthy box
      # that has simply not ticked (#221, one call site over).
      last="$(bxn "$name" 'tail -n 1 ~/duty/duty.log 2>/dev/null' 2>/dev/null | tr -d '\r' | cut -c1-60 || true)"
      note="${last:-no ticks yet}"
    fi
    # The wire vocabulary is lowercase; MODIFIED shouts for the same reason
    # MISSING does — it is the one row an operator must not skim past, and the
    # note names the version it diverged from so the column stays one word.
    case "$estate" in
      modified)
        edisplay=MODIFIED
        note="⚠ engine MODIFIED since ${erecorded:-its install} — crew status $name lists the files${note:+; $note}" ;;
      absent) edisplay=- ;;
      *)      edisplay="${estate:--}" ;;
    esac
    # shellcheck disable=SC2059
    printf "$fmt" "$name" "$state" "$host" "$hired" "$edisplay" "$ghs_d" "$vs_d" "$note"
  done < <(read_roster)
}

cmd_upgrade() {
  need_box
  local targets="" skipped="" target="" ref="HEAD" want force_arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)
        [ -z "$target" ] || usage_error "usage: $(synopsis_of upgrade)"
        target="--all"; shift ;;
      --ref) need_value "$@"; ref="$2"; shift 2 ;;
      # The override for install.sh's refusal to overwrite a MODIFIED engine
      # (#159). Nothing else consults it: the check is in the installer, where
      # the overwrite happens, so this only has to reach it.
      --force) force_arg="--force"; shift ;;
      --*) usage_error "unknown argument '$1' (usage: $(synopsis_of upgrade))" ;;
      *)
        [ -z "$target" ] || usage_error "usage: $(synopsis_of upgrade)"
        target="$1"; shift ;;
    esac
  done
  resolve_engine "$ref"
  want="$ENGINE_VERSION"
  case "$target" in
    --all)
      # The ROSTER, not every box on the host. `crew up` already leaves
      # off-roster boxes alone and says so; this verb reaching them meant a
      # disarmed box carrying a real identity and a production registry --
      # a drill box between runs, say -- could be armed by routine
      # maintenance (#37). Naming a box explicitly is still allowed: that is
      # a deliberate act on a known target, which `--all` is not.
      targets="$(comm -12 <(roster_names | sort) <(box_names | sort))"
      skipped="$(comm -23 <(box_names | sort) <(roster_names | sort))"
      ;;
    "")    usage_error "usage: $(synopsis_of upgrade)" ;;
    *)     targets="$target" ;;
  esac
  # After the target `case`, so `crew upgrade` with no target still earns its
  # invocation-fault 2 rather than this world-fault 1.
  require_operator_config "crew upgrade"
  local b armed flags line agent role identity_args registry_arg
  registry_arg="$(registry_install_arg)"
  for b in $targets; do
    echo "== upgrading $b"
    if [[ "$want" == *-dev* ]]; then
      echo "$b: crew@$want is a development tree — upgrade re-bakes unconditionally"
    fi
    # Preserve the box's armed state instead of asserting one. An upgrade
    # that arms a box nobody armed is a behaviour change wearing the
    # clothes of a version bump.
    if bxn "$b" 'crontab -l 2>/dev/null | grep -q ~/duty/bin/tick.sh' 2>/dev/null; then
      armed=1; flags="--arm-cron"
    else
      armed=0; flags=""
    fi
    line="$(roster_line "$b")"
    if [ -n "$line" ]; then
      read -r agent role _ <<<"$line"
      identity_args="$(install_identity_args "$b" "$agent" "$role")"
    else
      # An explicitly named off-roster box keeps its existing instance config.
      identity_args=""
    fi
    if stage_engine "$b" &&
       stage_fleet_definition "$b" &&
       install_staged_engine "$b" "$identity_args $registry_arg $flags $force_arg"; then
      :
    else
      cleanup_staged_engine "$b"
      echo "  upgrade FAILED on $b"
    fi
    # An `if`, not `[ … ] && echo`: as the loop body's last statement that
    # form returns 1 whenever the box WAS armed, and `set -e` would end the
    # loop after one box. Same shape as #25/#30.
    if [ "$armed" -eq 0 ]; then
      echo "  note: $b was NOT cron-armed; left disarmed (arm it with: crew hire $b)"
    fi
  done
  if [ -n "$skipped" ]; then
    echo
    echo "boxes on this host but not in the roster (left alone):"
    # shellcheck disable=SC2086  # splitting the name list is the point
    printf '  %s\n' $skipped
  fi
}

cmd_gold() {
  max_args gold 2 "$@"
  need_box
  local name="${1:-}" force="${2:-}"
  [ -n "$name" ] || usage_error "usage: crew gold <box> [--force]"
  require_operator_config "crew gold"
  # Gold images are the bake cache and must carry ZERO credentials — cut
  # them pre-auth. A logged-in box is refused.
  if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
    [ "$force" = "--force" ] || die "$name has live gh credentials — golds are cut PRE-login (--force to override)"
  fi
  local stamp ver
  stamp="$(hired_at "$name")"
  stamp="${stamp:-crew@unknown}"
  ver="$(stamp_version "$stamp" 2>/dev/null || echo unknown)"
  ver="${ver//[^A-Za-z0-9_.-]/-}"
  box snapshot "$name" "gold-crew-$ver"
  echo "gold cut: $name @ $stamp"
}

# crew floor — serve the fleet-floor console from THIS host, on IP:PORT.
#
# The floor reads every box over `box exec` and fires operator actions the same
# way (#38/#39). That is the whole point: the boxes have no inbound network
# path, but the host they run on has always had a control channel into them —
# the one `crew status` and `crew hire` already use. Nothing is installed in a
# box and no box has to reach out.
#
# It binds 0.0.0.0 by default because being reachable at IP:PORT is the job, so
# HTTP Basic auth is NOT optional: a page that can power-cycle boxes and start
# model sessions is not a page to leave open on a LAN. Without --pass or
# CREW_FLOOR_PASS one is generated and printed here, once.
cmd_floor() {
  need_box
  local port="${CREW_FLOOR_PORT:-8420}" bind="${CREW_FLOOR_BIND:-0.0.0.0}"
  local user="${CREW_FLOOR_USER:-operator}" pass="${CREW_FLOOR_PASS:-}"
  local interval="${CREW_FLOOR_INTERVAL:-60}" gen=0
  local roster="${CREW_FLOOR_ROSTER:-$ROSTER}"
  while [ $# -gt 0 ]; do
    case "$1" in
      --port)     need_value "$@"; port="$2";     shift 2 ;;
      --bind)     need_value "$@"; bind="$2";     shift 2 ;;
      --user)     need_value "$@"; user="$2";     shift 2 ;;
      --pass)     need_value "$@"; pass="$2";     shift 2 ;;
      --interval) need_value "$@"; interval="$2"; shift 2 ;;
      --roster)   need_value "$@"; roster="$2";   shift 2 ;;
      --local)    bind=127.0.0.1; shift ;;
      -h|--help) show_help floor; return 0 ;;
      *) usage_error "crew floor: unknown option '$1'" ;;
    esac
  done

  # The console is the ninth verb of #216's rule (#244). It reads like an
  # inspection surface and is not one: every button on the page fires through
  # POST /api/command, where `resume` uncomments a box's crontab and `message`
  # starts a real vendor-CLI session — the two acts #216 exists to stop the
  # fallback from performing. `do_command` gates only on the box being in the
  # resolved roster, and under the fallback the resolved roster is the shipped
  # one. Serving it is itself an act besides: a long-lived HTTP service on
  # 0.0.0.0 with a generated password is not the same category as printing a
  # table, and the browser gets none of the banner `crew status` prints.
  #
  # Placed after the option loop so `crew floor --port` still earns its
  # invocation-fault 2, and before the python3 / index.html / roster
  # preconditions so an unconfigured host gets the config answer rather than a
  # missing-build one. `--roster` does not lift it: that flag selects a roster
  # file while fleet.conf and the agent profiles still come from the resolved
  # config dir, so serving a console over a definition that is not the
  # resolved one is CREW_CONFIG_DIR's job.
  require_operator_config "crew floor"

  command -v python3 >/dev/null \
    || die "python3 is required for 'crew floor' (stdlib only, nothing to install)"
  [ -f "$CREW_ROOT/fleet-floor/index.html" ] \
    || die "fleet-floor/index.html is missing — run fleet-floor/build.sh"
  # Named at startup rather than surfaced as an empty fleet on first poll: a
  # typo'd --roster otherwise renders a console with nothing on it, which reads
  # exactly like a dead host.
  [ -f "$roster" ] || die "no roster at '$roster' (--roster / CREW_FLOOR_ROSTER)"

  if [ -z "$pass" ]; then
    pass="$(head -c 18 /dev/urandom | base64 | tr -d '/+=' | cut -c1-20)"
    gen=1
  fi

  # The address an operator actually types. A host with several NICs gets them
  # all rather than a guess.
  local ips
  ips="$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -E '^[0-9]' || true)"
  [ -z "$ips" ] && ips="127.0.0.1"

  echo "crew floor — fleet console"
  if [ "$bind" = "127.0.0.1" ]; then
    echo "  url       http://127.0.0.1:$port/   (loopback only)"
  else
    while read -r ip; do [ -n "$ip" ] && echo "  url       http://$ip:$port/"; done <<<"$ips"
  fi
  echo "  user      $user"
  if [ "$gen" -eq 1 ]; then
    echo "  password  $pass   (generated — pass --pass or CREW_FLOOR_PASS to fix it)"
  else
    echo "  password  (from --pass/CREW_FLOOR_PASS)"
  fi
  echo "  polling   every ${interval}s over 'box exec' — nothing runs inside the boxes"
  # Always printed, not only when overridden: which boxes the console is
  # watching is the first thing to check when it shows something surprising.
  echo "  roster    $roster"
  [ "$bind" = "127.0.0.1" ] \
    || echo "  NOTE      plain HTTP: the password crosses the network in the clear."
  echo

  CREW_FLOOR_PORT="$port" CREW_FLOOR_BIND="$bind" CREW_FLOOR_USER="$user" \
  CREW_FLOOR_PASS="$pass" CREW_FLOOR_INTERVAL="$interval" \
  CREW_FLOOR_ROSTER="$roster" \
    exec python3 "$CREW_ROOT/fleet-floor/server/floor.py"
}

cmd_init() {
  [ "$#" -le 1 ] || usage_error "usage: crew init [config-dir]"
  local target="${1:-}" file name _agent _role _from
  if [ -z "$target" ]; then
    if [ -n "${XDG_CONFIG_HOME:-}" ]; then target="$XDG_CONFIG_HOME/crew"
    else target="$HOME/.config/crew"; fi
  fi
  [ ! -e "$target" ] ||
    die "refusing to overwrite existing operator config '$target'"

  mkdir -p "$target/agents"
  for file in fleet.roster fleet.conf repos.txt notify-repos.txt doctrine.conf; do
    cp "$CREW_ROOT/examples/$file" "$target/$file"
  done

  echo "initialized operator config: $target"
  echo "edit the generated files, then run: CREW_CONFIG_DIR='$target' crew up"
  echo
  echo "static login obligations from fleet.roster (definition only; not a live auth check):"
  while read -r name _agent _role _from; do
    echo "  $name — by hand: box shell $name; gh auth login; then the agent login"
  done < <(grep -vE '^[[:space:]]*(#|$)' "$target/fleet.roster")
}

cmd_profiles() {
  max_args profiles 0 "$@"
  fallback_banner
  local f name
  echo "roles:"
  for f in "$ROLES_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
  echo "agents:"
  # The union of shipped and operator names, each resolved through agent_conf
  # so the line shown describes the file that will actually run; a profile the
  # operator supplied (or overrode) says so, because "listed here" must mean
  # "hireable" and an operator debugging a clash needs to see who won (#75).
  for name in $(agent_names | sort -u); do
    f="$(agent_conf "$name")"
    case "$f" in
      "$AGENTS_DIR"/*) echo "  $name — $(sed -n '1s/^# *//p' "$f")" ;;
      *)               echo "  $name — $(sed -n '1s/^# *//p' "$f")  [operator]" ;;
    esac
  done
}

# --- dispatch: driven by the table, not by a hand-written case --------------

cmd="${1:-help}"; shift || true
case "$cmd" in
  -h|--help)    usage; exit 0 ;;
  -V|--version) version; exit 0 ;;
  -*)           usage_error "options come after the command — try 'crew <command> $cmd ...'" ;;
esac

cmd="$(normalize_verb "$cmd")"
fn="$(field "$cmd" fn)" || unknown_command "$cmd"
"$fn" "$@"

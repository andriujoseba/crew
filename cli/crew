#!/usr/bin/env bash
# crew — spawn and tend the agent fleet, on a host with `box` installed.
#
#   crew new <name> | --role <r> --agent <a>  CREATE one box (fleet.roster by name, or ad-hoc)
#   crew create-all                           create every missing roster box
#   crew auth <box>                           log a box in (token env for gh; guided for the vendor)
#   crew hire <box> [--force]                 the box JOINS the crew: engine + cron (idempotent)
#   crew hire-all                             hire every created roster box (skips already-hired)
#   crew up [--dry-run]                       converge: create missing, start stopped, hire, report
#   crew down                                 stop every roster box
#   crew status [<box>]                       engine version + duty evidence
#   crew upgrade <box> | --all                pull crew + re-install in place
#   crew gold <box>                           snapshot a box as a gold image
#   crew profiles                             list role and agent profiles
#
# The lifecycle is three verbs because the middle one is human:
#
#   create  — infrastructure only: mint from the agent's box template (rig
#             converges the vendor CLI), sized by the role profile. The box
#             does NOTHING yet — no engine, no cron.
#   auth    — once per box, at creation time. Vendor logins are flaky and
#             change often, so they are done interactively while you are
#             already there; the GitHub half is automated (CREW_GH_TOKEN in
#             the host env is piped into `gh auth login --with-token` —
#             crew never writes it to disk — else the device flow runs
#             in-box). Do it once and never again.
#   hire    — the box joins the crew: engine baked at this checkout's pin,
#             cron armed, on duty at the next 5-minute boundary. Idempotent
#             upsert: already hired at this pin → skip (--force re-bakes).
#
# Fleet from scratch on a new server: install box + crew, `crew create-all`,
# log each box in (`crew auth` per box halves the pain), `crew hire-all`.
# Steady state afterwards is just `crew up`.
set -euo pipefail

CREW_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROLES_DIR="$CREW_ROOT/shared/conf/roles"
AGENTS_DIR="$CREW_ROOT/shared/conf/agents"
ROSTER="$CREW_ROOT/fleet.roster"
CREW_REPO="${CREW_REPO:-heavy-duty/crew}"

die() { echo "crew: $*" >&2; exit 1; }
need_box() { command -v box >/dev/null || die "the 'box' CLI is not on PATH — crew runs on a box host"; }
bxn() { box exec "$1" -- bash -lc "$2"; }

box_names() {
  box list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null \
    || box list 2>/dev/null | awk 'NR>1 {print $1}'
}
box_exists() { box_names | grep -qx "$1"; }

# Roster reader: <name> <agent> <role> [<from-box>/<snap>]; comments/blanks
# skipped. roster_line prints "agent role from" for one name.
read_roster() { grep -vE '^[[:space:]]*(#|$)' "$ROSTER"; }
roster_line() { read_roster | awk -v n="$1" '$1 == n {print $2, $3, $4; exit}'; }

validate_profiles() {  # agent role
  [ -f "$AGENTS_DIR/$1.conf" ] || die "unknown agent '$1' — see: crew profiles"
  [ -f "$ROLES_DIR/$2.conf" ]  || die "unknown role '$2' — see: crew profiles"
}

# create_box NAME AGENT ROLE [FROM] — infrastructure only, no engine.
create_box() {
  local name="$1" agent="$2" role="$3" from="${4:-}"
  local BOX_CPU="" BOX_MEMORY="" BOX_DISK=""
  # shellcheck disable=SC1090
  source "$ROLES_DIR/$role.conf"
  if [ -z "$BOX_CPU" ] || [ -z "$BOX_MEMORY" ] || [ -z "$BOX_DISK" ]; then
    die "role '$role' declares no BOX_CPU/BOX_MEMORY/BOX_DISK"
  fi
  if [ -n "$from" ]; then
    echo "creating $name  (role=$role agent=$agent from=$from)"
    box new --name "$name" --from "$from" --cpu "$BOX_CPU" --memory "$BOX_MEMORY" --disk "$BOX_DISK"
  else
    echo "creating $name  (role=$role agent=$agent cpu=$BOX_CPU mem=$BOX_MEMORY disk=$BOX_DISK template=$agent-box)"
    box new --name "$name" --template "$agent-box" --cpu "$BOX_CPU" --memory "$BOX_MEMORY" --disk "$BOX_DISK"
  fi
}

# hired_at NAME — the crew@<sha> the box's engine was installed from, if any.
hired_at() { bxn "$1" 'head -1 ~/duty/VERSION 2>/dev/null' 2>/dev/null | tr -d '\r\n'; }

# vendor_probe NAME AGENT — run the agent profile's bot_cli_probe inside the
# box, shipping the profile over stdin (works on unhired boxes too).
vendor_probe() {
  box exec "$1" -- bash -lc \
    'cat >/tmp/.crew-agent-probe.conf; source /tmp/.crew-agent-probe.conf; bot_cli_probe' \
    <"$AGENTS_DIR/$2.conf" >/dev/null 2>&1
}

# hire_box NAME AGENT ROLE REF FORCE — bake + arm; skip when already at REF.
hire_box() {
  local name="$1" agent="$2" role="$3" ref="$4" force="$5"
  local want have
  want="$(git -C "$CREW_ROOT" rev-parse --short "$ref" 2>/dev/null || echo "$ref")"
  have="$(hired_at "$name")"
  if [ "$force" -eq 0 ] && [ "$have" = "crew@$want" ]; then
    echo "$name: already hired at $have — skipping"
    return 0
  fi
  echo "hiring $name  (role=$role agent=$agent crew@$want)"
  bxn "$name" "
    set -euo pipefail
    if [ ! -d ~/crew/.git ]; then git clone --quiet https://github.com/$CREW_REPO ~/crew; fi
    git -C ~/crew fetch --quiet origin
    git -C ~/crew checkout --quiet '$ref'
    git -C ~/crew pull --quiet --ff-only origin '$ref' 2>/dev/null || true
    ~/crew/shared/install.sh --agent '$agent' --role '$role' --arm-cron
  "
  if bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "$name: hired — on duty at the next 5-minute boundary"
  else
    echo "$name: hired but NOT authenticated — it idles loudly until: crew auth $name"
  fi
}

cmd_new() {
  need_box
  local role="" agent="" name="" from="" login=0
  # Positional first argument = a roster name.
  if [ $# -gt 0 ]; then
    case "$1" in --*) : ;; *) name="$1"; shift ;; esac
  fi
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  role="$2";  shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --name)  name="$2";  shift 2 ;;
      --from)  from="$2";  shift 2 ;;
      --login) login=1;    shift ;;
      *) die "unknown argument '$1' (usage: crew new <roster-name> | crew new --role <r> --agent <a> [--name <n>] [--from <box>/<snap>] [--login])" ;;
    esac
  done
  if [ -n "$name" ] && [ -z "$role$agent" ]; then
    local line
    line="$(roster_line "$name")"
    [ -n "$line" ] || die "'$name' is not in $ROSTER (or pass --role/--agent for an ad-hoc box)"
    read -r agent role from <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then die "usage: crew new <roster-name> | crew new --role <r> --agent <a>"; fi
  validate_profiles "$agent" "$role"
  if [ -z "$name" ]; then
    name="$agent-$role"
    local i=2
    while box_exists "$name"; do name="$agent-$role-$i"; i=$((i + 1)); done
  fi
  box_exists "$name" && die "'$name' already exists (crew hire $name to put it on duty)"

  create_box "$name" "$agent" "$role" "$from"
  cat <<EOF

$name is created — vendor CLI converging via the $agent-box template; no
engine, no cron: it does nothing until hired. Next, once per box, ever:

  crew auth $name        # GitHub automated (CREW_GH_TOKEN or device flow),
                         # vendor login guided in a box shell
  crew hire $name        # joins the crew; on duty at the next 5-min boundary

(a NEW GitHub identity per box; add it to FLEET_MANIFEST in
shared/conf/fleet.conf, and for a reviewer decide the panel= changes first)
EOF
  [ "$login" -eq 1 ] && cmd_auth "$name"
  return 0
}

cmd_create_all() {
  need_box
  local name agent role from made=0
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    if box_exists "$name"; then
      echo "$name: exists"
    else
      create_box "$name" "$agent" "$role" "$from"
      made=$((made + 1))
    fi
  done < <(read_roster)
  echo
  echo "$made created. Next: 'crew auth <box>' for each new box (the worst part,"
  echo "halved: GitHub is automated), then 'crew hire-all'."
}

cmd_hire() {
  need_box
  local name="${1:-}"; shift || true
  case "$name" in ""|--*) die "usage: crew hire <box> [--role <r> --agent <a>] [--ref <git-ref>] [--force] [--login]" ;; esac
  local role="" agent="" ref="HEAD" force=0 login=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  role="$2";  shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --ref)   ref="$2";   shift 2 ;;
      --force) force=1;    shift ;;
      --login) login=1;    shift ;;
      *) die "unknown argument '$1'" ;;
    esac
  done
  box_exists "$name" || die "no box named '$name' — crew new $name first"
  if [ -z "$role$agent" ]; then
    local line
    line="$(roster_line "$name")"
    [ -n "$line" ] || die "'$name' is not in $ROSTER — pass --role and --agent"
    read -r agent role _ <<<"$line"
  fi
  if [ -z "$role" ] || [ -z "$agent" ]; then die "--role and --agent go together"; fi
  validate_profiles "$agent" "$role"
  [ "$login" -eq 1 ] && cmd_auth "$name"
  hire_box "$name" "$agent" "$role" "$ref" "$force"
}

cmd_hire_all() {
  need_box
  local ref="HEAD"
  [ "${1:-}" = "--ref" ] && ref="$2"
  local name agent role _from
  while read -r name agent role _from; do
    validate_profiles "$agent" "$role"
    if ! box_exists "$name"; then
      echo "$name: not created — crew new $name first"
      continue
    fi
    hire_box "$name" "$agent" "$role" "$ref" 0
  done < <(read_roster)
}

cmd_auth() {
  need_box
  local name="${1:-}"
  [ -n "$name" ] || die "usage: crew auth <box>   (CREW_GH_TOKEN in the env skips the GitHub prompt)"
  box_exists "$name" || die "no box named '$name' on this host"

  # Which agent? From the roster if listed, else from an installed engine.
  local agent=""
  local line
  line="$(roster_line "$name")"
  [ -n "$line" ] && agent="${line%% *}"
  [ -n "$agent" ] || agent="$(bxn "$name" "sed -n 's/^BOT_AGENT=//p' ~/duty/conf/instance.conf 2>/dev/null" | tr -d '\r\n')"
  [ -n "$agent" ] || die "cannot tell which agent '$name' runs — not in the roster and no engine installed"

  # GitHub: token from the host environment when provided (piped, never
  # written to disk by crew), device login in-box otherwise.
  if bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "github: already authenticated"
  elif [ -n "${CREW_GH_TOKEN:-}" ]; then
    if printf '%s' "$CREW_GH_TOKEN" | box exec "$name" -- bash -lc 'gh auth login --with-token'; then
      echo "github: token accepted"
    else
      die "github token login failed"
    fi
  else
    echo "== GitHub device login, running inside $name (a NEW identity: one box per identity):"
    box exec "$name" -- bash -lc 'gh auth login --hostname github.com --git-protocol https' || true
    bxn "$name" 'gh auth status >/dev/null 2>&1' || die "github login did not complete"
  fi
  echo "github identity: $(bxn "$name" 'gh api user --jq .login' | tr -d '\r\n')"

  # Vendor CLI: probe first; guided shell if it fails. The probe comes from
  # the agent profile in THIS checkout, shipped over stdin — the box may
  # not be hired yet, so nothing on it can be assumed.
  local hint
  hint="$(sed -n 's/^AGENT_LOGIN_HINT=//p' "$AGENTS_DIR/$agent.conf" | tr -d '"')"
  vendor_ok() { vendor_probe "$name" "$agent"; }
  if vendor_ok; then
    echo "$agent CLI: already authenticated"
  else
    [ -n "$hint" ] || hint="run the vendor CLI login"
    echo "== $agent CLI login — dropping you into the box shell; $hint; exit when done"
    box shell "$name" || true
    if vendor_ok; then
      echo "$agent CLI: authenticated"
    else
      die "$agent CLI probe still failing — re-run 'crew auth $name' after fixing it"
    fi
  fi
  echo
  echo "Authenticated, once and for all. Hire it when ready: crew hire $name"
}

cmd_up() {
  need_box
  local dry=0
  [ "${1:-}" = "--dry-run" ] && dry=1
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"

  local name agent role from state
  while read -r name agent role from; do
    validate_profiles "$agent" "$role"
    if ! box_exists "$name"; then
      if [ "$dry" -eq 1 ]; then echo "$name: WOULD create ($agent/$role${from:+ from $from})"; continue; fi
      create_box "$name" "$agent" "$role" "$from"
    else
      state="$(box info "$name" --json 2>/dev/null \
        | jq -r '.state // .status // "unknown"' 2>/dev/null | tr '[:upper:]' '[:lower:]')"
      if [ "$state" = "stopped" ]; then
        if [ "$dry" -eq 1 ]; then echo "$name: WOULD start"; else box start "$name"; echo "$name: started"; fi
      fi
    fi
    if [ "$dry" -eq 0 ]; then
      hire_box "$name" "$agent" "$role" HEAD 0
    else
      echo "$name: WOULD hire (currently: $(hired_at "$name"))" 2>/dev/null || echo "$name: WOULD hire"
    fi
  done < <(read_roster)

  if [ "$dry" -eq 0 ]; then
    echo
    echo "auth:"
    while read -r name _agent _role _from; do
      if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
        echo "  $name: logged in"
      else
        echo "  $name: AWAITING LOGIN  (crew auth $name)"
      fi
    done < <(read_roster)
    echo
    echo "boxes on this host but not in the roster (left alone):"
    comm -23 <(box_names | sort) <(read_roster | awk '{print $1}' | sort) | sed 's/^/  /' || true
  fi
}

cmd_down() {
  need_box
  [ -f "$ROSTER" ] || die "no roster at $ROSTER"
  local name _rest
  while read -r name _rest; do
    if box_exists "$name"; then
      box down "$name" || echo "  down FAILED on $name"
    else
      echo "  $name: not present, skipping"
    fi
  done < <(read_roster)
}

# crew status — no argument: the whole crew as a table, one roster member
# per row, with auth problems FLAGGED (an unauthenticated member fails
# loudly in its own duty.log every tick; this is the host-side view of the
# same fact). With a box name: the detailed view.
cmd_status() {
  need_box
  if [ -n "${1:-}" ]; then
    local b="$1"
    echo "== $b"
    box exec "$b" -- bash -lc '
      cat ~/duty/VERSION 2>/dev/null || echo "not hired (no engine)"
      tail -n 5 ~/duty/duty.log 2>/dev/null
    ' 2>/dev/null || echo "  (unreachable)"
    return 0
  fi

  local fmt='%-18s %-9s %-15s %-8s %-8s %s\n'
  # shellcheck disable=SC2059
  printf "$fmt" MEMBER STATE HIRED GH VENDOR NOTE
  local name agent role _from state hired ghs vs note last
  while read -r name agent role _from; do
    if ! box_exists "$name"; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" - - - - "NOT CREATED — crew new $name"
      continue
    fi
    state="$(box info "$name" --json 2>/dev/null \
      | jq -r '.state // .status // "?"' 2>/dev/null | tr '[:upper:]' '[:lower:]')"
    if [ "$state" = "stopped" ]; then
      # shellcheck disable=SC2059
      printf "$fmt" "$name" stopped - - - "crew up starts it"
      continue
    fi
    hired="$(hired_at "$name")"
    if bxn "$name" 'gh auth status >/dev/null 2>&1' >/dev/null 2>&1; then ghs=ok; else ghs=MISSING; fi
    if vendor_probe "$name" "$agent"; then vs=ok; else vs=MISSING; fi
    note=""
    [ -z "$hired" ] && { hired="not hired"; note="crew hire $name"; }
    if [ "$ghs" = MISSING ] || [ "$vs" = MISSING ]; then
      note="⚠ crew auth $name${note:+; $note}"
    elif [ -n "$hired" ] && [ "$hired" != "not hired" ]; then
      last="$(bxn "$name" 'tail -n 1 ~/duty/duty.log 2>/dev/null' 2>/dev/null | tr -d '\r' | cut -c1-60)"
      note="${last:-no ticks yet}"
    fi
    # shellcheck disable=SC2059
    printf "$fmt" "$name" "$state" "$hired" "$ghs" "$vs" "$note"
  done < <(read_roster)
}

cmd_upgrade() {
  need_box
  local targets=""
  case "${1:-}" in
    --all) targets="$(box_names)" ;;
    "")    die "usage: crew upgrade <box> | --all" ;;
    *)     targets="$1" ;;
  esac
  local b
  for b in $targets; do
    echo "== upgrading $b"
    # No flags: install.sh resolves from the manifest, or keeps the box's
    # existing instance.conf. Pre-auth boxes keep theirs too.
    box exec "$b" -- bash -lc '
      set -euo pipefail
      git -C ~/crew pull --ff-only --quiet
      ~/crew/shared/install.sh --arm-cron
    ' || echo "  upgrade FAILED on $b"
  done
}

cmd_gold() {
  need_box
  local name="${1:-}" force="${2:-}"
  [ -n "$name" ] || die "usage: crew gold <box> [--force]"
  # Gold images are the bake cache and must carry ZERO credentials — cut
  # them pre-auth. A logged-in box is refused.
  if bxn "$name" 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
    [ "$force" = "--force" ] || die "$name has live gh credentials — golds are cut PRE-login (--force to override)"
  fi
  local ver
  ver="$(hired_at "$name")"
  ver="${ver:-crew@unknown}"
  box snapshot "$name" "gold-${ver//[^A-Za-z0-9_.-]/-}"
  echo "gold cut: $name @ $ver"
}

cmd_profiles() {
  local f
  echo "roles:"
  for f in "$ROLES_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
  echo "agents:"
  for f in "$AGENTS_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
}

case "${1:-}" in
  new)        shift; cmd_new "$@" ;;
  create-all) shift; cmd_create_all "$@" ;;
  auth)       shift; cmd_auth "$@" ;;
  hire)       shift; cmd_hire "$@" ;;
  adopt)      shift; echo "crew: 'adopt' is now 'hire'" >&2; cmd_hire "$@" ;;
  hire-all)   shift; cmd_hire_all "$@" ;;
  up)         shift; cmd_up "$@" ;;
  down)       shift; cmd_down "$@" ;;
  status)     shift; cmd_status "$@" ;;
  upgrade)    shift; cmd_upgrade "$@" ;;
  gold)       shift; cmd_gold "$@" ;;
  profiles)   cmd_profiles ;;
  ""|help|-h|--help) sed -n '2,34s/^# \{0,1\}//p' "$0" ;;
  *) die "unknown command '${1}' — try: crew help" ;;
esac

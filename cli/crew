#!/usr/bin/env bash
# crew — spawn and tend the agent fleet, on a host with `box` installed.
#
#   crew up [--roster <file>] [--dry-run]     converge the host to a fleet roster
#   crew down [--roster <file>]               stop every roster box
#   crew new --role builder --agent claude    mint + bake + arm one crew box
#   crew adopt <box> --role <r> --agent <a>   bake + arm an EXISTING box
#   crew auth <box>                           log a box in (token env or guided)
#   crew status [<box>]                       engine version + duty evidence
#   crew upgrade <box> | --all                pull crew + re-install in place
#   crew gold <box>                           snapshot a box as a gold image
#   crew profiles                             list role and agent profiles
#
# Auth: CREW_GH_TOKEN in the host environment is piped into the box's
# `gh auth login --with-token` (never written to disk by crew); without it,
# `crew auth` runs GitHub's device login in-box and then walks you through
# the vendor CLI's login in a box shell, verifying with the agent's probe.
# Vendor token injection gets the same treatment once each vendor profile
# grows an agent_auth_with_env hook.
#
# Composition, not enumeration: a crew member is a ROLE profile (resources,
# cadence, session budgets, loadout — shared/conf/roles/) × an AGENT profile
# (CLI runtime, auth probe — shared/conf/agents/). `crew new` sizes the box
# from the role, mints it from the agent's box template (<agent>-box, which
# rig converges: vendor CLI, toolchain), bakes the duty engine from this
# checkout's pin, and arms cron. The box comes up with the boot gate loudly
# reporting dead auth — that is the CORRECT state, not an error: boxes are
# creds-free by default and this CLI never touches credentials. The operator
# logs the box in interactively; the first authenticated tick goes on duty.
#
# One role per box. The engine still runs the legacy dual-role instances
# (the manifest maps them), but this CLI only spawns single-role members —
# the fleet's target shape.
set -euo pipefail

CREW_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ROLES_DIR="$CREW_ROOT/shared/conf/roles"
AGENTS_DIR="$CREW_ROOT/shared/conf/agents"
CREW_REPO="${CREW_REPO:-heavy-duty/crew}"

die() { echo "crew: $*" >&2; exit 1; }

need_box() { command -v box >/dev/null || die "the 'box' CLI is not on PATH — crew runs on a box host"; }

bxn() { box exec "$1" -- bash -lc "$2"; }

box_names() {
  box list --json 2>/dev/null | jq -r '.[].name' 2>/dev/null \
    || box list 2>/dev/null | awk 'NR>1 {print $1}'
}

# The engine deploy + cron arm, run inside a box as its tenant user.
bake() {  # bake NAME AGENT ROLE REF
  local name="$1" agent="$2" role="$3" ref="$4"
  box exec "$name" -- bash -lc "
    set -euo pipefail
    if [ ! -d ~/crew/.git ]; then git clone --quiet https://github.com/$CREW_REPO ~/crew; fi
    git -C ~/crew fetch --quiet origin
    git -C ~/crew checkout --quiet '$ref'
    ~/crew/shared/install.sh --agent '$agent' --role '$role' --arm-cron
  "
}

cmd_new() {
  need_box
  local role="" agent="" name="" ref="" from="" force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  role="$2";  shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --name)  name="$2";  shift 2 ;;
      --ref)   ref="$2";   shift 2 ;;
      --from)  from="$2";  shift 2 ;;
      --force) force=1;    shift ;;
      *) die "unknown argument '$1' (usage: crew new --role <r> --agent <a> [--name <n>] [--ref <git-ref>] [--from <box>/<snapshot>] [--force])" ;;
    esac
  done
  if [ -z "$role" ] || [ -z "$agent" ]; then die "usage: crew new --role <r> --agent <a>"; fi
  [ -f "$ROLES_DIR/$role.conf" ]   || die "unknown role '$role' — see: crew profiles"
  [ -f "$AGENTS_DIR/$agent.conf" ] || die "unknown agent '$agent' — see: crew profiles"
  [ -z "$ref" ] && ref="$(git -C "$CREW_ROOT" rev-parse HEAD)"

  # Triage is a fleet singleton (sole issue-minter, notify owner).
  if [ "$role" = "triage" ] && [ "$force" -eq 0 ]; then
    if box_names | grep -q 'triage'; then
      die "a triage box already exists — triage is a singleton (--force to override)"
    fi
  fi

  # Resources come from the role profile.
  local BOX_CPU="" BOX_MEMORY="" BOX_DISK=""
  # shellcheck disable=SC1090
  source "$ROLES_DIR/$role.conf"
  if [ -z "$BOX_CPU" ] || [ -z "$BOX_MEMORY" ] || [ -z "$BOX_DISK" ]; then
    die "role '$role' declares no BOX_CPU/BOX_MEMORY/BOX_DISK"
  fi

  # Name: <agent>-<role>, first free ordinal suffix.
  if [ -z "$name" ]; then
    name="$agent-$role"
    local i=2 existing
    existing="$(box_names)"
    while printf '%s\n' "$existing" | grep -qx "$name"; do
      name="$agent-$role-$i"; i=$((i + 1))
    done
  fi

  if [ -n "$from" ]; then
    # Mint from a gold snapshot — the bake below still runs, so the engine
    # converges to this checkout's pin even off an older gold.
    echo "minting $name  (role=$role agent=$agent from=$from crew@${ref:0:12})"
    box new --name "$name" --from "$from" \
      --cpu "$BOX_CPU" --memory "$BOX_MEMORY" --disk "$BOX_DISK"
  else
    echo "minting $name  (role=$role agent=$agent cpu=$BOX_CPU mem=$BOX_MEMORY disk=$BOX_DISK template=$agent-box crew@${ref:0:12})"
    box new --name "$name" --template "$agent-box" \
      --cpu "$BOX_CPU" --memory "$BOX_MEMORY" --disk "$BOX_DISK"
  fi

  echo "baking the duty engine…"
  bake "$name" "$agent" "$role" "$ref"

  cat <<EOF

$name is up, baked, and ARMED — cron fires at the next 5-minute wall-clock
boundary and every one after. Until you log it in, each tick idles LOUDLY
by design (boot check, dead-auth warning, clean exit — three log lines,
zero sessions, zero board activity). Your only manual work:

  box shell $name
    gh auth login          # a NEW GitHub identity: one box per identity
    <$agent login>         # the vendor CLI's interactive login

Nothing to restart: the first 5-minute boundary after both logins passes
the boot gate and goes on duty (worst case: 5 minutes of latency).

Then: add the identity to FLEET_MANIFEST in shared/conf/fleet.conf (one
line) so re-installs resolve it — and if this is a reviewer, decide how the
governed repos' panel= rosters change BEFORE its first verdict is expected.
Consider 'crew gold $name' BEFORE logging in to cache this bake.
EOF
}

cmd_adopt() {
  need_box
  local name="${1:-}"; shift || true
  case "$name" in ""|--*) die "usage: crew adopt <box> --role <r> --agent <a> [--ref <git-ref>] [--login]" ;; esac
  local role="" agent="" ref="" login=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --role)  role="$2";  shift 2 ;;
      --agent) agent="$2"; shift 2 ;;
      --ref)   ref="$2";   shift 2 ;;
      --login) login=1;    shift ;;
      *) die "unknown argument '$1' (usage: crew adopt <box> --role <r> --agent <a> [--ref <git-ref>] [--login])" ;;
    esac
  done
  if [ -z "$role" ] || [ -z "$agent" ]; then die "usage: crew adopt <box> --role <r> --agent <a>"; fi
  [ -f "$ROLES_DIR/$role.conf" ]   || die "unknown role '$role' — see: crew profiles"
  [ -f "$AGENTS_DIR/$agent.conf" ] || die "unknown agent '$agent' — see: crew profiles"
  box_names | grep -qx "$name" || die "no box named '$name' on this host"
  [ -z "$ref" ] && ref="$(git -C "$CREW_ROOT" rev-parse HEAD)"

  echo "adopting $name  (role=$role agent=$agent crew@${ref:0:12})"
  bake "$name" "$agent" "$role" "$ref"
  echo
  echo "$name is baked and ARMED — cron fires at the next 5-minute boundary."
  echo "install.sh has disarmed any old-engine entrypoints into ~/duty/legacy/"
  echo "inside the box; check its output above for stale cron lines to delete."
  if [ "$login" -eq 1 ]; then
    cmd_auth "$name"
  elif ! bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "Not logged in yet — it idles loudly until: crew auth $name"
  fi
}

cmd_auth() {
  need_box
  local name="${1:-}"
  [ -n "$name" ] || die "usage: crew auth <box>   (CREW_GH_TOKEN in the env skips the GitHub prompt)"
  box_names | grep -qx "$name" || die "no box named '$name' on this host"
  local agent
  agent="$(bxn "$name" "sed -n 's/^BOT_AGENT=//p' ~/duty/conf/instance.conf 2>/dev/null" | tr -d '\r\n')"
  [ -n "$agent" ] || die "$name has no engine installed (no instance.conf) — crew adopt it first"

  # GitHub: token from the host environment when provided (piped, never
  # written to disk by crew), device login in-box otherwise.
  if bxn "$name" 'gh auth status >/dev/null 2>&1'; then
    echo "github: already authenticated"
  elif [ -n "${CREW_GH_TOKEN:-}" ]; then
    if printf '%s' "$CREW_GH_TOKEN" | box exec "$name" -- bash -lc 'gh auth login --with-token'; then
      echo "github: token accepted"
    else
      die "github token login failed"
    fi
  else
    echo "== GitHub device login, running inside $name (a NEW identity: one box per identity):"
    box exec "$name" -- bash -lc 'gh auth login --hostname github.com --git-protocol https' || true
    bxn "$name" 'gh auth status >/dev/null 2>&1' || die "github login did not complete"
  fi
  echo "github identity: $(bxn "$name" 'gh api user --jq .login' | tr -d '\r\n')"

  # Vendor CLI: probe first; guided shell if it fails. Token injection per
  # vendor lands here once the agent profile grows agent_auth_with_env.
  local hint=""
  hint="$(sed -n 's/^AGENT_LOGIN_HINT=//p' "$AGENTS_DIR/$agent.conf" | tr -d '"')"
  if bxn "$name" "source ~/duty/conf/agents/$agent.conf 2>/dev/null && bot_cli_probe"; then
    echo "$agent CLI: already authenticated"
  else
    [ -n "$hint" ] || hint="run the vendor CLI login"
    echo "== $agent CLI login — dropping you into the box shell; $hint; exit when done"
    box shell "$name" || true
    if bxn "$name" "source ~/duty/conf/agents/$agent.conf 2>/dev/null && bot_cli_probe"; then
      echo "$agent CLI: authenticated"
    else
      die "$agent CLI probe still failing — the box stays in loud-idle until it passes"
    fi
  fi
  echo
  echo "Fully authenticated. Nothing to restart: the next 5-minute boundary goes on duty."
}

# Roster reader: <name> <agent> <role> [<from-box>/<snap>], comments/blanks
# skipped. Every roster consumer goes through here.
read_roster() {
  grep -vE '^[[:space:]]*(#|$)' "$1"
}

cmd_up() {
  need_box
  local roster="$CREW_ROOT/fleet.roster" dry=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --roster)  roster="$2"; shift 2 ;;
      --dry-run) dry=1; shift ;;
      *) die "unknown argument '$1' (usage: crew up [--roster <file>] [--dry-run])" ;;
    esac
  done
  [ -f "$roster" ] || die "no roster at $roster"

  local existing name agent role from state summary=""
  existing="$(box_names)"
  while read -r name agent role from; do
    [ -n "${role:-}" ] || die "roster line for '${name:-?}' needs: <name> <agent> <role>"
    [ -f "$ROLES_DIR/$role.conf" ]   || die "roster: unknown role '$role' for $name"
    [ -f "$AGENTS_DIR/$agent.conf" ] || die "roster: unknown agent '$agent' for $name"
    if printf '%s\n' "$existing" | grep -qx "$name"; then
      state="$(box info "$name" --json 2>/dev/null \
        | jq -r '.state // .status // "unknown"' 2>/dev/null | tr '[:upper:]' '[:lower:]')"
      if [ "$state" = "stopped" ]; then
        [ "$dry" -eq 1 ] || box start "$name"
        summary="$summary$name: started
"
      else
        summary="$summary$name: already running ($state)
"
      fi
    elif [ "$dry" -eq 1 ]; then
      summary="$summary$name: WOULD mint ($agent/$role${from:+ from $from})
"
    else
      # --force: the roster is the singleton authority here — it names
      # exactly one triage box, so cmd_new's name-based triage guard would
      # only misfire (e.g. on a re-run racing box list).
      cmd_new --role "$role" --agent "$agent" --name "$name" --force ${from:+--from "$from"}
      summary="$summary$name: minted ($agent/$role)
"
    fi
  done < <(read_roster "$roster")

  echo
  echo "== crew up: $roster"
  printf '%s' "$summary"

  # Rosters converge machines; identities stay the operator's. Say who is
  # still waiting for a login rather than making anyone go look.
  if [ "$dry" -eq 0 ]; then
    echo
    echo "auth:"
    while read -r name _agent _role _from; do
      if box exec "$name" -- bash -lc 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
        echo "  $name: logged in"
      else
        echo "  $name: AWAITING LOGIN  (box shell $name → gh auth login + vendor login)"
      fi
    done < <(read_roster "$roster")
    echo
    echo "boxes on this host but not in the roster (left alone):"
    comm -23 <(box_names | sort) <(read_roster "$roster" | awk '{print $1}' | sort) | sed 's/^/  /' || true
  fi
}

cmd_down() {
  need_box
  local roster="$CREW_ROOT/fleet.roster"
  [ "${1:-}" = "--roster" ] && roster="$2"
  [ -f "$roster" ] || die "no roster at $roster"
  local existing name _rest
  existing="$(box_names)"
  while read -r name _rest; do
    if printf '%s\n' "$existing" | grep -qx "$name"; then
      box down "$name" || echo "  down FAILED on $name"
    else
      echo "  $name: not present, skipping"
    fi
  done < <(read_roster "$roster")
}

cmd_status() {
  need_box
  local targets="${1:-}"
  [ -n "$targets" ] || targets="$(box_names)"
  local b
  for b in $targets; do
    echo "== $b"
    box exec "$b" -- bash -lc '
      cat ~/duty/VERSION 2>/dev/null || echo "no engine installed"
      tail -n 3 ~/duty/duty.log 2>/dev/null
    ' 2>/dev/null || echo "  (unreachable)"
  done
}

cmd_upgrade() {
  need_box
  local targets=""
  case "${1:-}" in
    --all) targets="$(box_names)" ;;
    "")    die "usage: crew upgrade <box> | --all" ;;
    *)     targets="$1" ;;
  esac
  local b
  for b in $targets; do
    echo "== upgrading $b"
    # No flags: install.sh resolves from the manifest, or keeps the box's
    # existing instance.conf. Pre-auth boxes keep theirs too.
    box exec "$b" -- bash -lc '
      set -euo pipefail
      git -C ~/crew pull --ff-only --quiet
      ~/crew/shared/install.sh --arm-cron
    ' || echo "  upgrade FAILED on $b"
  done
}

cmd_gold() {
  need_box
  local name="${1:-}" force="${2:-}"
  [ -n "$name" ] || die "usage: crew gold <box> [--force]"
  # Gold images are the bake cache and must carry ZERO credentials — cut
  # them pre-login. A logged-in box is refused.
  if box exec "$name" -- bash -lc 'gh auth status >/dev/null 2>&1' 2>/dev/null; then
    [ "$force" = "--force" ] || die "$name has live gh credentials — golds are cut PRE-login (--force to override)"
  fi
  local ver
  ver="$(box exec "$name" -- bash -lc 'head -1 ~/duty/VERSION 2>/dev/null' 2>/dev/null | tr -d '\r' || true)"
  ver="${ver:-crew@unknown}"
  box snapshot "$name" "gold-${ver//[^A-Za-z0-9_.-]/-}"
  echo "gold cut: $name @ $ver"
}

cmd_profiles() {
  local f
  echo "roles:"
  for f in "$ROLES_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
  echo "agents:"
  for f in "$AGENTS_DIR"/*.conf; do
    echo "  $(basename "$f" .conf) — $(sed -n '1s/^# *//p' "$f")"
  done
}

case "${1:-}" in
  up)       shift; cmd_up "$@" ;;
  down)     shift; cmd_down "$@" ;;
  new)      shift; cmd_new "$@" ;;
  adopt)    shift; cmd_adopt "$@" ;;
  auth)     shift; cmd_auth "$@" ;;
  status)   shift; cmd_status "$@" ;;
  upgrade)  shift; cmd_upgrade "$@" ;;
  gold)     shift; cmd_gold "$@" ;;
  profiles) cmd_profiles ;;
  ""|help|-h|--help) sed -n '2,20s/^# \{0,1\}//p' "$0" ;;
  *) die "unknown command '${1}' — try: crew help" ;;
esac

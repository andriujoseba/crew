# playwright-core is installed locally to run the page half; it is a developer
# dependency of the tests, never part of the repo. CI installs it fresh.
node_modules/
node_modules
package-lock.json
# `npm i playwright-core` (rather than --no-save) writes one of these; CI and
# the drill both install with --no-save and never do. It is the same developer
# artifact as the lockfile above and reached a commit once, so it is named.
package.json
shots/

# py_compile and importlib leave these behind; the fixtures ship as source
# only. Same rule as ../server/.gitignore — a stale __pycache__ here made a
# clean tree report a FALSE failure while the regressions above were being
# verified, which is a bad half-hour to hand the next person.
__pycache__/
*.pyc

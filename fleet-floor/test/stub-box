#!/usr/bin/env bash
# stub-box — a fake `box` CLI, so the collector and the page can be tested on
# any machine, with no Incus, no VMs and no real fleet.
#
# The fleet it presents is driven by a fixture file ($FLOOR_FIXTURE), one line
# per box:
#
#     <box-name> <incus-state> <scenario>
#
# incus-state is what `box list --json` reports (running / stopped / absent).
# scenario selects the duty evidence `box exec` answers with — see emit_probe.
# That is the whole point of the file: a test needs to say "this box is
# wedged" or "this box was hired 30 seconds ago and has no sessions yet"
# without owning a box in that state.
#
# Every invocation is appended to $FLOOR_CALLS, and lifecycle verbs mutate
# per-box state under $FLOOR_STATE, so a test can assert what the host
# actually DID — not merely that a request returned 200.
set -u

FIXTURE="${FLOOR_FIXTURE:?stub-box needs FLOOR_FIXTURE}"
CALLS="${FLOOR_CALLS:-/dev/null}"
STATEDIR="${FLOOR_STATE:-${TMPDIR:-/tmp}/floor-stub-state}"
mkdir -p "$STATEDIR"

printf '%s\n' "$*" >> "$CALLS"

now() { date -u '+%Y-%m-%dT%H:%M:%SZ'; }
ago() { date -u -d "@$(( $(date +%s) - ${1:-0} ))" '+%Y-%m-%dT%H:%M:%SZ'; }
box_ago() {
  local sc="$1" age="$2" skew=0
  case "$sc" in skew-behind|skew-silent-behind) skew=-10800 ;; skew-ahead|skew-silent-ahead) skew=10800 ;; esac
  date -u -d "@$(( $(date +%s) + skew - age ))" '+%Y-%m-%dT%H:%M:%SZ'
}

rows()         { grep -vE '^[[:space:]]*(#|$)' "$FIXTURE"; }
fixture_line() { rows | awk -v n="$1" '$1==n {print; exit}'; }
scenario_of()  {
  if [ -f "$STATEDIR/$1.scenario" ]; then cat "$STATEDIR/$1.scenario"
  else fixture_line "$1" | awk '{print $3}'; fi
}
# The agent the ROSTER claims for this box, so a healthy stub box agrees with
# its own roster row and only the 'wrongagent' scenario disagrees. The floor
# now compares the two, and a stub that always said "claude" would have made
# every non-claude fixture row look like a mismatch.
roster_agent_of() {
  local r="${CREW_FLOOR_ROSTER:-}" a=""
  if [ -n "$r" ] && [ -f "$r" ]; then
    a="$(grep -vE '^[[:space:]]*(#|$)' "$r" | awk -v n="$1" '$1==n {print $2; exit}')"
  fi
  printf '%s\n' "${a:-claude}"
}
# Lifecycle verbs write an override so `box down` is visible to a later
# `box list`. A control whose effect cannot be observed proves nothing.
state_of() {
  local n="$1"
  if [ -f "$STATEDIR/$n.state" ]; then cat "$STATEDIR/$n.state"
  else fixture_line "$n" | awk '{print $2}'; fi
}
cron_of() {
  local n="$1"
  if [ -f "$STATEDIR/$n.cron" ]; then cat "$STATEDIR/$n.cron"
  elif [ "$(scenario_of "$n")" = "paused" ]; then echo paused
  else echo running; fi
}

# armed_of NAME — true when the box has a LIVE `tick.sh` line. One reader,
# because three answers now derive from it: probe.sh's ::cron below, and the
# verdicts PAUSE_SH and RESUME_SH reach (#188). A stub whose pause half and
# probe half disagreed about one box would let exactly the disagreement these
# tests exist to catch pass green.
armed_of() {
  local n="$1"
  [ "$(cron_of "$n")" = "paused" ] && return 1     # pausing comments the line out
  case "$(scenario_of "$n")" in nocron|disarmed) return 1 ;; esac
  return 0
}

# vitals_record_of SCENARIO — the box vitals record tick.sh would have written
# into duty.log (#483). ONE reader, for the reason armed_of above is one: BOTH
# halves of this stub answer with it — probe.sh's `::vitals` for the floor, and
# the CLI's detail probe for `crew status` — and #483's whole criterion is that
# those two cannot disagree. A stub that spelled the record twice could hold
# them apart while the suite stayed green, which is the one failure this fixture
# must not be able to hide.
#
# Three shapes, because neither reader may collapse them:
#
#   working  a complete record, both findings, and a backfilled disk series
#   idle     a DEGRADED record — no `free`, so no memory fields and no swap
#            pair, and no boot-check.log, so no series. D6 is per-field, and
#            the rows that survive must still render.
#   others   no record at all, which is every box on an engine older than the
#            probe. Both readers draw no section rather than dashes.
#
# As with ::integrity the VALUES are fixture data — the stub has no hardware to
# measure. Their truth is asserted in boxside.sh, which runs the real probe.sh
# over a real duty.log. What this buys is the two renderings.
vitals_record_of() {
  case "$1" in
    working|suppressed-working)
      printf 'VITALS ts=%s cores=2 load1=0.41 mem_total_mb=3850 mem_shared_mb=103 mem_avail_mb=3128 swap_active_mb=0 swap_configured_mb=8192 disk_total_mb=29696 disk_used_mb=14254 disk_pct=48 disk_series=2026-08-01T12:50:01+00:00@9,2026-08-10T21:15:01+00:00@31,2026-08-27T18:35:01+00:00@48 platform=linux os=debian-13 finding=swap-configured-inactive:configured_mb=8192,active_mb=0 finding=cpu-profile-mismatch:want=4,got=2\n' \
        "$(now)" ;;
    idle)
      printf 'VITALS ts=%s cores=2 load1=0.00 disk_total_mb=29696 disk_used_mb=14254 disk_pct=48 platform=linux os=debian-13\n' \
        "$(now)" ;;
    *) printf '\n' ;;
  esac
}

# emit_probe NAME SCENARIO — the `::key value` record probe.sh would produce.
emit_probe() {
  local n="$1" sc="$2" paused=0 cron=1
  # Pausing COMMENTS the tick line out, so a paused box counts zero live
  # `tick.sh` lines exactly like a disarmed one — probe.sh's ::cron is
  # `grep -cE '^[^#].*tick\.sh'`. The stub used to report cron=1 while paused,
  # which is the one shape a real box cannot be in, and it would have hidden a
  # wake-silent that skipped paused boxes (#189).
  [ "$(cron_of "$n")" = "paused" ] && paused=1
  armed_of "$n" || cron=0

  case "$sc" in
    nothired|unconverged|premanifest) printf '::engine \n' ;;
    *)        printf '::engine crew@0.4.1 (deadbee)\n' ;;
  esac
  # The engine-integrity verdict probe.sh gets from engine-manifest.sh (#159),
  # and the one field on this record the stub cannot honestly compute: there is
  # no installed tree here to hash, so the VALUE is fixture data. Its TRUTH is
  # asserted where it can be — boxside.sh runs the real engine-manifest.sh
  # through the real probe.sh for all three hired states, as shared/test/run.sh
  # does for the CLI half. What this fixture buys is the page walk: three
  # verdicts that must render distinctly, which needs three boxes carrying them.
  #
  # `absent` tracks ::engine above and must keep tracking it: state() answers
  # absent exactly when VERSION is empty, which is exactly when the stamp is,
  # and a fixture where one says hired and the other says absent is a shape no
  # box can be in.
  case "$sc" in
    nothired|unconverged|premanifest) printf '::integrity absent\n' ;;
    modified)   printf '::integrity modified\n' ;;
    unverified) printf '::integrity unverified\n' ;;
    *)          printf '::integrity current\n' ;;
  esac
  # The agent the box was ACTUALLY installed as. The roster may claim another,
  # and that disagreement is the thing the floor now reports — so the stub has
  # to be able to produce it. 'wrongagent' is a box installed as codex while
  # the roster says otherwise.
  case "$sc" in
    nothired|unconverged|premanifest)   printf '::agent \n' ;;
    wrongagent) printf '::agent codex\n' ;;
    *)          printf '::agent %s\n' "$(roster_agent_of "$n")" ;;
  esac
  printf '::uptime %s\n' "$([ "$sc" = fresh ] && echo 61 || echo 91820)"
  printf '::now %s\n' "$(now)"
  # `flowing`, not `ok`: the probe no longer TESTS a credential, it reports
  # what the duty flow last observed. Keeping `ok` here would have let the
  # collector be written against a vocabulary probe.sh does not emit — the
  # exact circularity this stub exists to avoid, and the reason boxside.sh
  # re-checks these keys against the real script.
  # Mirrors probe.sh exactly: a rejection is `missing`, a box with no engine
  # has never had a flow to report anything so it is `unknown`, and only a
  # hired box with no recorded failure is `flowing`. A stub that said
  # `flowing` for an unhired box would have let the collector treat "nobody
  # has complained yet" as a working credential.
  # The box reports a FACT (`nofail` + ::tickage); the host ages it into
  # flowing-or-stale. Emitting a verdict here would let the collector be
  # written against a vocabulary probe.sh no longer speaks.
  _cred=nofail
  case "$sc" in
    nothired|unconverged|premanifest) _cred=unknown ;;
    noauth)   _cred=missing ;;
  esac
  # Tick age drives the host's verdict: fresh for a healthy box, long past two
  # boundaries for the ones that have stopped ticking — which is what makes
  # `stale` reachable at all.
  case "$sc" in
    silent|suppressed-silent|nocron|disarmed|skew-silent-behind|skew-silent-ahead) _tickage=4000 ;;
    # -1 is "no duty.log to read an age from" — true of a box that was never
    # hired, and equally true of one hired a minute ago that has not ticked.
    invalid-tickage|suppressed-unknown) _tickage=garbage ;;
    nothired|neverticked|unconverged|premanifest) _tickage=-1 ;;
    skew-behind|skew-ahead) _tickage=110 ;;
    *)             _tickage=30 ;;
  esac
  [ "$sc" = missing-tickage ] || printf '::tickage %s\n' "$_tickage"
  printf '::gh %s\n'     "$_cred"
  printf '::vendor %s\n' "$_cred"
  [ "$sc" = noauth ] && printf '::authfail-gh 2026-07-27T09:14:02Z 401 Bad credentials\n'
  # A duty run that started 47 minutes ago and never let go: alive, ticking,
  # and doing nothing. There is no other way to reach the STUCK branch — a
  # real fleet produces this state only by breaking.
  case "$sc" in stuck|suppressed-stuck) printf '::lockheld 2820\n' ;; esac
  case "$sc" in suppressed|suppressed-silent|suppressed-unknown|suppressed-working|suppressed-stuck|suppressed-notimestamp|suppressed-old-orphan|suppressed-paired-crash)
    printf '::suppression 780 draft heavy-duty/crew#561@abcdef123456\n'
    ;;
  *)
    printf '::suppression \n'
    ;;
  esac
  printf '::cron %s\n'   "$cron"
  printf '::paused %s\n' "$paused"
  # Full owner/repo, exactly as repos.txt holds them. Bare names here are
  # what let a broken repo-link URL pass review-clean for two rounds.
  printf '::repos heavy-duty/crew heavy-duty/box heavy-duty/ceremony\n'
  printf '::sessionlogs 20260726T090000Z-build-crew_40.log 20260726T093000Z-review-box_158.log\n'
  # The box vitals record (#483), carried by probe.sh verbatim off duty.log.
  # ONE source for it, because the CLI half of this stub answers with the same
  # record a few hundred lines down: a stub whose two halves disagreed about
  # one box would let exactly the disagreement these tests exist to catch pass
  # green — the rule this file already applies to the armed/paused counts.
  printf '::vitals %s\n' "$(vitals_record_of "$sc")"
  echo '::logstart'
  case "$sc" in
    working|suppressed-working|paused|noauth|skew-behind|skew-ahead|invalid-tickage)
      # a closed session, then an open one: state must read WORKING
      echo "$(box_ago "$sc" 900) duty run start"
      echo "$(box_ago "$sc" 900) heavy-duty/crew: build duty (ready unclaimed=2, whole rounds owed=0)"
      echo "$(box_ago "$sc" 890) SESSION START kind=build key=crew#40 timeout=7200s log=/h/duty/logs/a.log"
      echo "$(box_ago "$sc" 600) SESSION END kind=build key=crew#40 rc=0 dur=290s outcome=ok"
      echo "$(box_ago "$sc" 600) duty run end"
      echo "$(box_ago "$sc" 120) duty run start"
      echo "$(box_ago "$sc" 120) attention: heavy-duty/ceremony#12 — launching pickup session"
      echo "$(box_ago "$sc" 110) SESSION START kind=triage key=board timeout=2400s log=/h/duty/logs/b.log"
      ;;
    idle)
      echo "$(ago 200) duty run start"
      echo "$(ago 200) heavy-duty/crew: no build duty"
      # The one scenario written with #473's field: the newest session per box
      # is what the page renders it for, and `working` above deliberately
      # keeps the pre-field line shape so both halves have a fixture.
      echo "$(ago 195) SESSION END kind=review key=box#158 rc=0 dur=64s outcome=approved acted=yes reply_tail= tier=default peak_rss=3588324"
      echo "$(ago 190) duty run end"
      ;;
    silent|suppressed-silent|disarmed)   # newest line is older than two tick boundaries
      echo "$(ago 3000) duty run start"
      echo "$(ago 2990) duty run end"
      ;;
    skew-silent-behind|skew-silent-ahead)
      echo "$(box_ago "$sc" 4010) duty run start"
      echo "$(box_ago "$sc" 4000) duty run end"
      ;;
    missing-tickage|suppressed-unknown)
      echo "$(ago 110) duty run start"
      ;;
    suppressed-notimestamp)
      echo "log exists but carries no parseable timestamp"
      ;;
    suppressed-old-orphan)
      echo "$(ago 28800) SESSION START kind=build key=crew#old timeout=7200s log=/h/duty/logs/old.log"
      ;;
    suppressed-paired-crash)
      echo "$(ago 7200) SESSION START kind=build key=crew#crashed timeout=7200s log=/h/duty/logs/crashed.log"
      echo "$(ago 120) SESSION START kind=review key=crew#done timeout=2400s log=/h/duty/logs/done.log"
      echo "$(ago 60) SESSION END kind=review key=crew#done rc=0 dur=60s outcome=ok"
      ;;
    firstrun)  # its very first session: an open START, no END anywhere yet
      echo "$(ago 200) duty run start"
      echo "$(ago 200) heavy-duty/rig: build duty (ready unclaimed=1, whole rounds owed=0)"
      echo "$(ago 190) SESSION START kind=build key=heavy-duty/rig#3 timeout=7200s log=/h/duty/logs/f.log"
      ;;
    fresh|nothired|nocron|neverticked|unconverged|premanifest) : ;;  # hired seconds ago: no evidence yet
    failing)
      echo "$(ago 300) duty run start"
      echo "$(ago 295) SESSION END kind=build key=crew#41 rc=1 dur=12s outcome=FAILED"
      echo "$(ago 290) SESSION END kind=build key=crew#42 rc=124 dur=7200s outcome=TIMEOUT"
      echo "$(ago 280) duty run end"
      ;;
    hostile)  # log content that must never be interpreted as markup
      echo "$(ago 120) duty run start"
      echo "$(ago 120) attention: <img src=x onerror=alert(1)>#7 — launching pickup session"
      echo "$(ago 110) SESSION START kind=build key=<script>alert(2)</script> timeout=60s log=/h/x.log"
      ;;
    garbage)  # a truncated / interleaved log the parser must survive
      echo "not a timestamped line at all"
      echo "$(ago 100) SESSION END kind=build key=crew#9 rc=notanumber dur=xx outcome="
      echo "$(ago 90) SESSION START kind= key="
      printf '\x00\xff binary junk\n'
      ;;
    *) echo "$(now) duty run start" ;;
  esac
  echo '::logend'
}

case "${1:-}" in
  list)
    printf '['
    first=1
    while read -r name _st _sc; do
      st="$(state_of "$name")"
      [ "$st" = "absent" ] && continue
      [ "$first" -eq 1 ] || printf ','
      first=0
      printf '{"name":"%s","state":"%s"}' "$name" "$(printf '%s' "$st" | tr '[:lower:]' '[:upper:]')"
    done < <(rows)
    printf ']\n'
    ;;

  # The shape that made #47 possible, and the gap that let it ship: `crew
  # status` and `crew up` both read `box info --json`, the stub had no `info`
  # subcommand at all, and no test in this repo invoked cli/crew — so CI could
  # not see either call site.
  #
  # The real payload is an ARRAY whose element carries a capitalised `status`
  # STRING and a `state` OBJECT. Filtering it as an object (`.state //
  # .status`) asks jq to index an array with a string; jq exits 5, and under
  # `set -euo pipefail` in a command substitution that killed the whole
  # command. Reproduced faithfully here, because a stub that returned a
  # convenient bare object would have let the bug through again.
  info)
    name="$2"
    st="$(state_of "$name")"
    if [ -z "$st" ] || [ "$st" = "absent" ]; then
      echo "Error: instance \"$name\" not found" >&2; exit 1
    fi
    ST_UP="$(printf '%s' "$st" | tr '[:lower:]' '[:upper:]')"
    printf '[{"name":"%s","status":"%s","state":{"status":"%s","network":{}}}]\n' \
      "$name" "$ST_UP" "$ST_UP"
    ;;

  exec)
    name="$2"
    # The real `box exec` forwards stdin; drain it the same way so a caller
    # writing a prompt or an agent profile never blocks on a full pipe.
    #
    # PER-INVOCATION, not one file per box: the collector probes concurrently,
    # so a probe (stdin = agent profile) could land between the message hop's
    # write and its read, and the profile ended up saved as the prompt. That
    # made `message: prompt delivered via stdin` fail intermittently — a flaky
    # test in the suite CI gates on.
    stdin_copy="$STATEDIR/$name.stdin.$$"
    cat > "$stdin_copy" 2>/dev/null || true
    trap 'rm -f "$stdin_copy"' EXIT
    script="${*: -1}"
    st="$(state_of "$name")"
    sc="$(scenario_of "$name")"

    [ "$st" = "stopped" ] && { echo "Error: instance is not running" >&2; exit 1; }
    [ "$sc" = "unreachable" ] && { echo "Error: instance is not running" >&2; exit 1; }
    [ "$sc" = "wedged" ] && { sleep 120; exit 1; }   # never answers — probe must time out

    # Order is load-bearing; these scripts share substrings:
    #  - probe.sh also mentions CREW-FLOOR-PAUSED (it counts paused lines)
    #  - resume's sed and pause's sed both contain "CREW-FLOOR-PAUSED "
    #  - the message session also reads ".floor-prompt", like the write hop
    # Each pattern is therefore the narrowest string unique to one of them.
    # shellcheck disable=SC2016  # the patterns are LITERAL fragments of the
    # scripts being matched, not strings to expand: $HOME is the box's.
    case "$script" in
      *'destination="$HOME/.crew-engine.tgz"'*) # crew's engine archive upload
        if [ "${STUB_ENGINE_UPLOAD_FAIL:-0}" = 1 ]; then
          exit 1
        fi
        cp "$stdin_copy" "$STATEDIR/$name.engine.tgz"
        ;;
      *'tar xzf "$archive" -C "$stage"'*)       # engine staging extraction
        rm -rf "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine-received"
        mkdir -p "$STATEDIR/$name.engine-stage"
        if [ "${STUB_ENGINE_EXTRACT_FAIL:-0}" = 1 ] ||
           ! tar xzf "$STATEDIR/$name.engine.tgz" -C "$STATEDIR/$name.engine-stage"; then
          rm -rf "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine.tgz"
          exit 1
        fi
        cp -R "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine-received"
        ;;
      *'"$stage/shared/install.sh"'*)            # staged host engine install
        if [ -e "$STATEDIR/$name.has-crew" ]; then
          rm -f "$STATEDIR/$name.has-crew"
          : >"$STATEDIR/$name.crew-retired"
          echo "crew: retired obsolete box-side engine source ~/crew to crew.retired"
        fi
        if [ "${STUB_INSTALL_FAIL:-0}" = 1 ]; then
          rm -rf "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine.tgz"
          echo "forced staged install failure" >&2
          exit 1
        fi
        version="$(head -1 "$STATEDIR/$name.engine-stage/VERSION")"
        printf 'crew@%s (fixture)\n' "$version" >"$STATEDIR/$name.version"
        rm -rf "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine.tgz"
        echo "installed for stub-bot (agent: stub, roles: stub)"
        echo "crontab armed"
        ;;
      *'rm -rf ~/.crew-engine-stage ~/.crew-engine.tgz'*)
        rm -rf "$STATEDIR/$name.engine-stage" "$STATEDIR/$name.engine.tgz"
        ;;
      *'.crew-stage.XXXXXX'*)                  # crew's fleet-definition transport
        : ;;
      *'rm -rf ~/duty/.crew-seed-agents'*)     # agent-profile seed reset (#75)
        : ;;
      # The ping tier: `box exec <box> -- true`, the whole heartbeat. It needs
      # no case of its own to FAIL correctly — stopped, unreachable and wedged
      # are all handled above, and they are the states a ping exists to catch.
      # It needs this one to SUCCEED, and without it every ping fell through
      # to the unmatched-script exit 3 below, so a healthy fleet read as
      # totally unreachable after three rounds. Deliberately first: `true` is
      # a substring of nothing else here, but the ping is also the only script
      # that must stay this cheap, and matching it last would mean walking
      # every other pattern 6 times a minute per box.
      *'printf "u %s'*)
        # The ping. Matched on its own printf format, NOT on /proc/uptime —
        # probe.sh reads that file too, and this case sits above probe.sh's,
        # so the looser pattern hijacked every probe in the suite. Narrowest
        # string unique to one script, exactly like every other pattern here.
        #
        # Answers the way a real guest would: a healthy IDLE box has
        # NO .duty.lock.since — that is the normal state — so it prints an
        # empty lock field and still exits 0. A stub that always printed a
        # number would hide this change's sharp edge, which is that `cat` on a
        # missing file exits 1 and would have rendered every healthy box
        # UNREACHABLE.
        echo "u $([ "$sc" = fresh ] && echo 61 || echo 91820)"
        # An AGE, because that is what the real script emits after converting
        # .duty.lock.since (an absolute `date +%s` stamp). Emitting a
        # pre-computed 2820 here while the real script shipped the raw stamp is
        # how a unit mismatch stayed green: the collector was only ever tested
        # against the stub's arithmetic. boxside.sh now runs the real script
        # and asserts the conversion; this stays an age so the two agree.
        case "$sc" in
          stuck)  echo "l 2820" ;;
          # A run that started moments ago — the case that was marked STUCK
          # with a multi-year duration. It must stay unremarkable.
          working) echo "l 12" ;;
          *)      echo "l" ;;
        esac ;;
      *'echo "::logstart"'*)                    emit_probe "$name" "$sc" ;;
      # ABOVE the two CREW-FLOOR-PAUSED cases below, by this block's own
      # ordering rule. Since #189 crew's auth_from_flow counts the PAUSED
      # crontab lines as well as the live ones, so its script now contains the
      # literal `CREW-FLOOR-PAUSED` and the broad pattern below would answer a
      # status read with a crontab count — and, worse, record the box as
      # paused as a side effect of reading it. `duty/.auth-fail.` stays the
      # narrowest string unique to this one script.
      *'duty/.auth-fail.'*)                     # crew's auth_from_flow
        # Matched on `duty/.auth-fail.` — probe.sh reads the same markers, but
        # via "$DUTY_DIR/.auth-fail.$svc", so this substring belongs to the
        # CLI's script alone. It sits ABOVE the hired_at case because the script
        # also reads duty/VERSION (to tell 'never ticked' from 'no failure
        # recorded'), and hired_at's pattern would otherwise answer it with a
        # version string — which crew then parsed as the gh column.
        # Like every pattern here it is the narrowest
        # string unique to one script; the two are otherwise near-identical and
        # a looser match would answer the probe in the CLI's format.
        # Two more fields since #189: the armed and paused crontab COUNTS, the
        # same pair probe.sh emits as ::cron / ::paused. They are derived here
        # exactly as emit_probe derives them — a stub whose CLI half and floor
        # half disagreed about one box would let the very disagreement these
        # tests exist to catch pass green.
        _armed=1; _cpaused=0
        [ "$(cron_of "$name")" = "paused" ] && { _armed=0; _cpaused=1; }
        case "$sc" in nocron|disarmed|nothired|unconverged|premanifest) _armed=0 ;; esac
        _log=1; _active=0; _lock=-1
        case "$sc" in
          nothired|unconverged|premanifest|neverticked|suppressed-notimestamp) _log=0 ;;
          working|suppressed-working|suppressed-paired-crash|noauth|skew-behind|skew-ahead|invalid-tickage) _active=1 ;;
          stuck|suppressed-stuck) _lock=2820 ;;
        esac
        case "$sc" in
          noauth)        echo "missing missing 30 $_armed $_cpaused -1 - - $_log $_active $_lock" ;;
          nothired|unconverged|premanifest) echo "unknown unknown -1 $_armed $_cpaused -1 - - $_log $_active $_lock" ;;
          # Hired and armed, nothing recorded against it, and no duty.log to
          # age: the box is healthy and has simply not run yet.
          neverticked)   echo "nofail nofail -1 $_armed $_cpaused -1 - - $_log $_active $_lock" ;;
          silent|nocron|disarmed) echo "nofail nofail 4000 $_armed $_cpaused -1 - - $_log $_active $_lock" ;;
          suppressed-silent) echo "nofail nofail 4000 $_armed $_cpaused 780 draft heavy-duty/crew#561@abcdef123456 $_log $_active $_lock" ;;
          suppressed-unknown) echo "nofail nofail garbage $_armed $_cpaused 780 draft heavy-duty/crew#561@abcdef123456 $_log $_active $_lock" ;;
          suppressed|suppressed-working|suppressed-stuck|suppressed-notimestamp|suppressed-old-orphan|suppressed-paired-crash)
            echo "nofail nofail 30 $_armed $_cpaused 780 draft heavy-duty/crew#561@abcdef123456 $_log $_active $_lock" ;;
          *)             echo "nofail nofail 30 $_armed $_cpaused -1 - - $_log $_active $_lock" ;;
        esac ;;
      # RESUME_SH, then PAUSE_SH. Since #188 each script states what it DID and
      # a box with nothing to do says so on stdout and exits 0 — so the stub has
      # to be able to produce that answer. It used to echo `1` unconditionally,
      # which is the one thing a real box cannot do: it made every pause take
      # effect here, so the zero-count path that reddened the whole control
      # block on a real host had no representation in this suite at all.
      *"s|^#CREW-FLOOR-PAUSED ||"*)
        if [ "$(cron_of "$name")" = "paused" ]; then
          echo resumed > "$STATEDIR/$name.cron"; echo "resumed 1"
        else
          echo "nothing to resume: no paused tick.sh line"
        fi ;;
      *CREW-FLOOR-PAUSED*)
        if armed_of "$name"; then
          echo paused > "$STATEDIR/$name.cron"; echo "paused 1"
        else
          echo "nothing to pause: no armed tick.sh line"
        fi ;;
      *'cat > "$HOME/duty/.floor-prompt'*)
        # Hop 1 of a message. Staged into a per-box SANDBOX HOME, not just
        # recorded: hop 2 below runs the real MESSAGE_SH against that sandbox,
        # so the prompt has to be where the script will actually look for it.
        _tok="$(printf '%s' "$script" | sed -n 's/.*\.floor-prompt\.\([a-f0-9]*\)".*/\1/p')"
        _home="$STATEDIR/$name.home"
        mkdir -p "$_home/duty/logs" "$_home/.local/bin"
        cp "$stdin_copy" "$_home/duty/.floor-prompt.${_tok:-notoken}"
        # Kept for the assertions that only care about hop 1.
        cp "$stdin_copy" "$STATEDIR/$name.prompt.${_tok:-notoken}"
        cp "$stdin_copy" "$STATEDIR/$name.prompt" ;;
      *BOT_CLI_CMD*)
        # Hop 2: EXECUTE the real MESSAGE_SH rather than pretending to. Echoing
        # "session started" made the concurrency test vacuous — it proved five
        # files were staged, and would have passed just as happily if every
        # detached session then read the wrong one (codex-bot, eaaff99).
        _home="$STATEDIR/$name.home"
        mkdir -p "$_home/duty/logs" "$_home/.local/bin"
        # A stand-in for each vendor CLI, on the PATH the agent profile
        # prepends. It echoes the prompt it was handed; MESSAGE_SH redirects
        # that into the per-request log, which is what makes the one-to-one
        # mapping observable.
        # Written once, atomically. Truncating these in place raced the
        # concurrent sessions: one was rewritten WHILE another was executing
        # it, and that session produced no output at all.
        for _cli in claude codex grok kimi; do
          if [ ! -x "$_home/.local/bin/$_cli" ]; then
            printf '#!/usr/bin/env bash\nprintf "PROMPT=[%%s]\\n" "${*: -1}"\n' > "$_home/.local/bin/.$_cli.$$"
            chmod +x "$_home/.local/bin/.$_cli.$$"
            mv -f "$_home/.local/bin/.$_cli.$$" "$_home/.local/bin/$_cli"
          fi
        done
        HOME="$_home" bash -c "$script" < "$stdin_copy"
        ;;
      # --- the scripts cli/crew runs, so `crew status` and `crew up` can be
      # driven here. Every one of these substrings ALSO appears in probe.sh,
      # which is why they sit below its `::logstart` case — the order comment
      # above applies to them exactly as it does to the rest.
      *'/etc/rig/role'*)                        # crew's rig_report (#220)
        # rig's ground truth, in the shape rig actually writes — read on
        # 2026-08-01 from a real rig-converged tenant box (the builder's own,
        # rig 0.3.2-dev), not inferred from rig's source:
        #
        #     /etc/rig/role      role=claude-box tenant=yes host=no
        #     /etc/rig/manifest  schema=1
        #                        bootstrapped_by=0.3.2-dev
        #                        bootstrapped_at=2026-08-01T12:31:11Z
        #                        converged_by=0.3.2-dev
        #                        converged_at=2026-08-01T12:31:11Z
        #
        # Reproduced in that shape rather than a convenient `converged=1`,
        # because the parse crew does is the thing under test — a stub emitting
        # a tidier format would test a format no box has, and the previous
        # version of this case did exactly that (`rig_version=rig@0.6.0`, a
        # string no rig produces, against a rename that ran on the far side of
        # this stub and so was never executed at all).
        #
        # crew's rig_report does no interpreting box-side: it cats both files
        # and prefixes the manifest's lines, so what this stub owes it is those
        # lines verbatim. The version is BARE (`0.3.2-dev`, no `rig@`), and the
        # manifest's `bootstrapped_*` pair comes FIRST and here deliberately
        # differs from `converged_*` — a box bootstrapped once and re-converged
        # by a later rig — so a read that went after the FAMILY (`.*_at=`)
        # rather than the whole key would be visibly wrong here rather than
        # accidentally right. On a real manifest the two pairs are usually
        # equal, which is why the stub is where that near-miss can be seen.
        #
        # `probe=ok` first and unconditionally: it is how the CLI tells a box
        # that answered nothing from one that answered "no marker", and those
        # two must never collapse. `unreachable` and `stopped` never reach here
        # at all — they exit above, which is exactly the case that must read
        # `unknown`.
        echo probe=ok
        if [ "$sc" != "unconverged" ]; then
          printf 'marker=role=%s-box tenant=yes host=no\n' "$(roster_agent_of "$name")"
          # A converged box with NO manifest is a box built by a rig older than
          # that file (rig#61) — old, not broken — and must still read
          # `converged`. It is the corroborating-only rule made observable.
          if [ "$sc" != "premanifest" ]; then
            printf 'rig:schema=1\n'
            printf 'rig:bootstrapped_by=0.3.1\n'
            printf 'rig:bootstrapped_at=%s\n' "$(ago 172800)"
            printf 'rig:converged_by=0.3.2-dev\n'
            printf 'rig:converged_at=%s\n' "$(ago 86400)"
          fi
        fi ;;
      *'engine-manifest.sh'*)                   # crew's engine_report (#159)
        # ABOVE the hired_at case, by the same ordering rule as auth_from_flow:
        # this script names duty/VERSION in its own pre-#159 fallback branch,
        # and the looser pattern below would answer the report with a bare
        # version string — which the CLI then reads as an EMPTY stamp, i.e. a
        # hired box reporting "not hired". `engine-manifest.sh` is the
        # narrowest string unique to this one script.
        #
        # A stub box is a clean install by construction: there is no tree here
        # to diverge from. `modified` and `unverified` are asserted end to end
        # in shared/test/run.sh, against a REAL installed tree, which is the
        # only place the hash can prove anything at all.
        # A caller can silence just this probe while leaving rig_report and the
        # duty-log read reachable. That mixed-answer fixture guards the detail
        # view's state discriminator without inventing another fleet row.
        [ "${STUB_ENGINE_REPORT_FAIL:-}" = "$name" ] && exit 1
        case "$sc" in nothired|unconverged|premanifest) _unhired=1 ;; *) _unhired=0 ;; esac
        if [ "$_unhired" = 1 ]; then
          printf 'state=absent\nstamp=\nrecorded=\n'
        else
          _ver="$(cat "$STATEDIR/$name.version" 2>/dev/null || echo "crew@0.4.1 (deadbee)")"
          printf 'state=current\nstamp=%s\nrecorded=%s\n' "$_ver" "$_ver"
        fi ;;
      *'duty/VERSION'*)                         # crew's hired_at
        case "$sc" in
          nothired|unconverged|premanifest) : ;;
          *) cat "$STATEDIR/$name.version" 2>/dev/null || echo "crew@0.4.1 (deadbee)" ;;
        esac ;;
      *'gh auth status'*)                       # crew hire / boot gate
        [ "$sc" = "noauth" ] && exit 1; exit 0 ;;
      *bot_cli_probe*)                          # crew's vendor_probe
        [ "$sc" = "noauth" ] && exit 1; exit 0 ;;
      *'instance.conf'*)                        # crew's box_agent
        # AFTER the ::logstart case: probe.sh reads instance.conf too, now that
        # it reports the box's own agent. Same ordering rule as the rest.
        case "$sc" in
          nothired|unconverged|premanifest) : ;;
          *) printf 'BOT_AGENT=%s\n' "$(roster_agent_of "$name")" ;;
        esac ;;
      *'duty/repos.txt'*)                       # crew's box_registry (#51)
        cat "$STATEDIR/$name.repos" 2>/dev/null || {
          echo heavy-duty/ceremony; echo heavy-duty/incubator; echo heavy-duty/rig; } ;;
      *'::crew-vitals-end::'*)                  # crew's status_probe (detail view)
        # ABOVE `*tail*`, by this block's ordering rule: the CLI's detail probe
        # ends in `tail -n 5 ~/duty/duty.log`, so the looser pattern below
        # would answer it with a two-line stub log and no section marks at all
        # — which is exactly how the vitals and budget halves would read as
        # "the box answered nothing" while the box was answering fine.
        # `::crew-vitals-end::` is the narrowest string unique to this script.
        #
        # The three sections in the order cli/crew splits them on. The budget
        # half stays EMPTY: no lane is configured on a stub box, which is the
        # default and the honest report, and the budget suite drives that half
        # elsewhere. What matters here is that the marks are present, because
        # their absence is what the CLI reads as silence.
        [ "$sc" = "neverticked" ] && exit 1
        echo "::crew-budget-end::"
        # The SAME record probe.sh answers the floor with, from the same
        # reader. See vitals_record_of.
        vitals_record_of "$sc"
        echo "::crew-vitals-end::"
        echo "$(now) duty run start"; echo "stub log for $name" ;;
      *tail*)
        # A box that has never ticked has NO ~/duty/duty.log, so the real
        # `tail -n 1 ~/duty/duty.log 2>/dev/null` prints nothing and exits 1 —
        # and `box exec` propagates that status. Reproduced faithfully, because
        # a stub that returned empty-and-0 here would have let #224 through
        # again: the defect is entirely in what the CALLER does with the
        # non-zero status under `set -o pipefail`.
        [ "$sc" = "neverticked" ] && exit 1
        echo "$(now) duty run start"; echo "stub log for $name" ;;
      *) echo "stub-box: unmatched exec script for $name" >&2; exit 3 ;;
    esac
    ;;

  # A guest that cannot schedule its own shutdown does not answer `box down`
  # either. `box down` is `incus stop` with no force and no timeout, so the
  # call blocks until the CALLER's deadline — the floor's ACTION_TIMEOUT_S —
  # and then reports failure. That is the 2026-08-14 state #486 exists for,
  # and a stub whose `down` always succeeded instantly is what let the floor
  # claim it had stopped a box it had not: every graceful-stop assertion in
  # this suite was written against a fleet where stopping always works.
  #
  # Same scenario as the hanging `exec` above, because it is the same guest:
  # one that has stopped being able to run anything cannot run its own
  # shutdown. `sleep 120` rather than a hang forever, so a suite that loses
  # its collector still terminates.
  #
  # And `down` IS NOT IDEMPOTENT, which this arm used to pretend it was: it wrote
  # `stopped` and exited 0 whatever state the box was in, which is the one
  # thing the real CLI will not do. In heavy-duty/box at 518d930, `down` is
  # registered `incus:stop` (bin/box:157) and the SINGLE-box path runs
  # `incus $sub "$inst"` bare under `set -euo pipefail` (:3420); the guard for
  # this case, `fleet_op`'s `stop:STOPPED -> ""` (:1187), is reached only from
  # `run_fleet`, i.e. only by `box down all`. box's own comment at :1153 names
  # the fact — Incus errors when an instance is already in the state you asked
  # for. So a caller that reads its stop result gets a FAILURE here, and a stub
  # that answered success let a floor which acts on that result pass green.
  # First, and before the hang: a stopped guest has nothing to schedule, so
  # Incus refuses at once rather than blocking on a shutdown that never comes.
  # Two refusals before the hang, both of them Incus's and neither of them
  # modelled here before: a box the host does not have (the `info` arm above
  # has always answered this one, and `down` disagreeing with it was a fleet no
  # host can be in), and one already in the state the verb asks for.
  down)
    _dst="$(state_of "$2")"
    if [ -z "$_dst" ] || [ "$_dst" = "absent" ]; then
      echo "Error: Instance not found \"$2\"" >&2; exit 1
    fi
    [ "$_dst" = "stopped" ] && {
      echo "Error: The instance is already stopped" >&2; exit 1; }
    [ "$(scenario_of "$2")" = "wedged" ] && { sleep 120; exit 1; }
    echo stopped > "$STATEDIR/$2.state"; echo "stopped $2" ;;
  # `box incus <box> -- <argv>` — box's non-interactive passthrough, and the
  # way through to a force stop (#486 D2: the flag belongs to incus, not to a
  # new `box down --force`, per heavy-duty/box#11's ownership rule).
  #
  # Only `stop --force` is modelled. A stub that answered every incus verb
  # would be inventing a contract nothing in this repo relies on, and the
  # unmatched arm below is the assertion that the floor fires exactly the
  # passthrough the issue ruled and not a near neighbour.
  incus)
    # `--` is checked WHERE IT IS, not assumed. `shift 3` past an argv that
    # put the separator somewhere else would silently reinterpret the call as
    # a different passthrough, and the unmatched arm below — which is where
    # this stub does its real assertion work, by refusing anything but the
    # ruled command — would never see it. It is also the load-bearing token:
    # box's global option loop consumes it, which is what stops `--force`
    # being eaten by box's own `--force`.
    if [ "$#" -lt 4 ] || [ "$3" != "--" ]; then
      echo "stub-box: malformed incus passthrough '$*'" >&2; exit 2
    fi
    _iname="$2"; shift 3
    case "$*" in
      "stop --force")
        # Kills the guest whatever it is doing — which is the whole point, so
        # it answers on the box the graceful verb hangs against.
        echo stopped > "$STATEDIR/$_iname.state"; echo "force-stopped $_iname" ;;
      *) echo "stub-box: unhandled incus passthrough '$*'" >&2; exit 2 ;;
    esac ;;
  start) echo running > "$STATEDIR/$2.state"; echo "started $2" ;;
  snapshot) echo "snapshotted $2 as $3" ;;
  # `crew new` mints infrastructure only; the stub records the mint so a test
  # can assert the sizing/template arguments without owning an Incus (#75).
  new)   echo "created" ;;
  *) echo "stub-box: unhandled '$*'" >&2; exit 2 ;;
esac
